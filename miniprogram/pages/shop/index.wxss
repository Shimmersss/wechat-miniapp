/* 搜索框和筛选栏吸顶：上下边距算进 --search-h，筛选栏才能贴着搜索框停住。 */
.home { --search-h: 112rpx; padding-top: 0; }
.home .search-sticky {
  position: sticky; top: 0; z-index: 30;
  height: var(--search-h); box-sizing: border-box; padding: 16rpx 0;
  background: var(--c-bg);
}
.home .search-sticky .search-bar { margin: 0; }
.brand-grid { display: grid; grid-template-columns: repeat(4, 1fr); row-gap: 20rpx; padding: 12rpx 0 20rpx; }
.brand-tile { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 10rpx 0; border-radius: var(--radius); }
.brand-tile.active { background: var(--c-surface); box-shadow: var(--e1); }
.brand-press { opacity: 0.7; }
.brand-img { width: 112rpx; height: 112rpx; }
.brand-name { font-size: 26rpx; color: var(--c-ink); }
.brand-tile.active .brand-name { font-weight: 700; }
.filter-sticky { display: block; position: sticky; top: var(--search-h); z-index: 20; margin-bottom: 16rpx; }
.filter-sticky.raised { z-index: 40; }
.end { text-align: center; padding: 40rpx 0 10rpx; }
