<theme-shell>
<view class="container has-tabbar home">
  <view class="search-sticky">
    <view class="search-bar" bindtap="onSearchTap"><image class="search-icon" src="/assets/icons/search-gray.svg" />搜索品牌 / 型号 / 存储 / 运行内存</view>
  </view>

  <view wx:if="{{scoped}}" class="notice">当前查看分享内商品<button class="btn btn-line btn-sm" bindtap="onBrowseAll">浏览全部现货</button></view>

  <block wx:else>
    <swiper class="brand-swiper" current="{{tilePage}}" bindchange="onTilePage">
      <swiper-item wx:for="{{tilePages}}" wx:for-item="pageItem" wx:key="index">
        <view class="brand-grid">
          <view wx:for="{{pageItem.tiles}}" wx:key="key" class="brand-tile {{filters.brandKey === item.key ? 'active' : ''}}" hover-class="brand-press" data-key="{{item.key}}" bindtap="onBrandTap">
            <view class="brand-media">
              <image wx:if="{{!brandImagesReady[item.key]}}" class="brand-img" src="/assets/images/device-placeholder.png" mode="aspectFit" lazy-load="{{true}}" />
              <image wx:if="{{item.image}}" class="brand-img {{brandImagesReady[item.key] ? '' : 'brand-img-loading'}}" src="{{item.image}}" data-key="{{item.key}}" bindload="onBrandImageLoad" mode="aspectFit" lazy-load="{{true}}" />
            </view>
            <text class="brand-name">{{item.label}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:if="{{tilePages.length > 1}}" class="brand-dots">
      <view wx:for="{{tilePages}}" wx:key="index" class="brand-dot {{tilePage === index ? 'on' : ''}}" data-index="{{index}}" bindtap="onTileDot"></view>
    </view>
  </block>

  <view id="filter-anchor"></view>
  <shop-filter id="filter" class="filter-sticky {{filterRaised ? 'raised' : ''}}" value="{{filters}}" bind:change="onFilterChange" bind:overlay="onFilterOverlay" />

  <view wx:if="{{error}}" class="notice">{{error}}<button class="btn btn-line btn-sm" bindtap="refresh">重试</button></view>
  <view class="grid-2">
    <product-card wx:for="{{list}}" wx:key="id" unit="{{item}}" bind:select="onUnitSelect" />
  </view>

  <empty-state wx:if="{{!loading && !error && !list.length}}" text="暂无符合条件的现货，换个条件试试" />
  <view wx:if="{{list.length && !hasMore}}" class="tiny muted end">— 每台设备独立检测 · 公开机况 —</view>
</view>
</theme-shell>
