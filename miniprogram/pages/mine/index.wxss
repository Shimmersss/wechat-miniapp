.profile { display: flex; align-items: center; gap: 24rpx; }
.avatar { width: 104rpx; height: 104rpx; border-radius: 50%; background: var(--c-ink); color: var(--c-on-ink); font-size: 44rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
.center { text-align: center; margin-top: 40rpx; }

/* 主题切换：分段控件（凹槽底 + 选中墨色实心，和全站控件语言一致） */
.theme-seg {
  display: flex;
  gap: 4rpx;
  padding: 4rpx;
  border-radius: var(--radius-pill);
  background: var(--c-well);
  box-shadow: inset 0 2rpx 4rpx var(--c-hair);
}
.theme-opt {
  padding: 10rpx 22rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-muted);
}
.theme-opt.on {
  background: var(--c-action);
  color: var(--c-action-ink);
  box-shadow: var(--e-ink);
}
