.hero { padding: 48rpx 36rpx; border-radius: var(--radius-lg); margin-bottom: var(--gap); color: #fff; background: var(--c-navy); }
.hero-title { font-size: 52rpx; font-weight: 700; letter-spacing: -1rpx; margin: 24rpx 0 16rpx; }
.hero-sub { font-size: 28rpx; color: rgba(255,255,255,.72); line-height: 1.8; }
.benefit { display: flex; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--c-line); }
.benefit:last-child { border-bottom: 0; }
.no { width: 64rpx; height: 64rpx; border-radius: 18rpx; background: var(--c-surface-soft); color: var(--c-ink); font-weight: 600; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.rule { line-height: 2; }
