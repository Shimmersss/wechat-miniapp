.hero {
  position: relative; overflow: hidden;
  padding: 40rpx 36rpx 44rpx; margin-bottom: var(--gap);
  border-radius: var(--radius-xl);
  background: var(--hero-bg); color: var(--hero-ink);
  box-shadow: var(--e2);
}
.hero-deco { position: absolute; right: 0; top: 0; width: 340rpx; height: 100%; pointer-events: none; }
.hero-tag {
  position: relative; display: inline-block; padding: 8rpx 22rpx;
  border-radius: var(--radius-pill); background: var(--hero-chip);
  font-size: 24rpx; font-weight: 600;
}
.hero-title { position: relative; margin-top: 28rpx; font-size: 54rpx; font-weight: 800; letter-spacing: -1rpx; }
.hero-sub { position: relative; margin-top: 16rpx; max-width: 500rpx; font-size: 28rpx; line-height: 1.65; color: var(--hero-ink-2); }
.hero-slogan { position: relative; margin-top: 28rpx; font-size: 24rpx; color: var(--hero-ink-2); }

/* 算账卡 */
.sum { display: flex; align-items: flex-start; justify-content: space-between; gap: 6rpx; }
.sum-item { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.sum-value { font-size: 36rpx; font-weight: 800; color: var(--c-ink); }
.sum-value.earn { color: var(--c-green); }
.sum-label { font-size: 22rpx; color: var(--c-muted); text-align: center; }
.sum-sign { flex: none; font-size: 30rpx; line-height: 48rpx; color: var(--c-ink-4); }
.earn-note {
  margin-top: 24rpx; padding: 16rpx 24rpx; border-radius: var(--radius-sm);
  background: var(--c-green-soft); color: var(--c-green);
  font-size: 28rpx; font-weight: 700; text-align: center;
}
.hint { margin-top: 14rpx; font-size: 22rpx; color: var(--c-muted); text-align: center; }

/* 卖点 */
.perks { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.perk { padding: 24rpx; border-radius: var(--radius); background: var(--c-surface-soft); }
.perk-icon { display: block; width: 76rpx; height: 76rpx; }
.perk-title { margin-top: 16rpx; font-size: 30rpx; font-weight: 700; color: var(--c-ink); }
.perk-desc { margin-top: 8rpx; font-size: 24rpx; line-height: 1.5; color: var(--c-ink-2); }

/* 步骤 */
.step { position: relative; display: flex; gap: 20rpx; padding-bottom: 32rpx; }
.step:last-child { padding-bottom: 0; }
.step:not(:last-child)::before {
  content: ""; position: absolute; left: 25rpx; top: 56rpx; bottom: 4rpx;
  width: 2rpx; background: var(--c-line);
}
.step-no {
  flex: none; width: 52rpx; height: 52rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--c-selected); color: var(--c-on-selected);
  font-size: 26rpx; font-weight: 700;
}
.step-title { font-size: 30rpx; font-weight: 700; color: var(--c-ink); line-height: 52rpx; }
.step-desc { margin-top: 2rpx; font-size: 26rpx; line-height: 1.55; color: var(--c-ink-2); }

.rule { padding: 14rpx 0; font-size: 26rpx; line-height: 1.6; color: var(--c-ink-2); border-bottom: 1rpx solid var(--c-line); }
.rule:last-child { border-bottom: 0; padding-bottom: 0; }

/* 主按钮放在内容流里（不再 fixed），上方留出与卡片的间距 */
.apply-cta { margin-top: 8rpx; }

/* tabBar 占位：自定义 tabBar 是 fixed 的，高度 104rpx + 底部安全区。
   这里必须留够，否则滑到底时按钮会被 tabBar 压住。 */
.tabbar-space { height: calc(104rpx + env(safe-area-inset-bottom)); }
