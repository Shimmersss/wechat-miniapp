.hero { padding: 48rpx 36rpx; border-radius: var(--radius-xl); margin-bottom: var(--gap); color: var(--c-on-hero, var(--c-ink));
  background: var(--c-glass); backdrop-filter: blur(22px) saturate(180%);
  -webkit-backdrop-filter: blur(22px) saturate(180%);
  box-shadow: var(--e3), inset 0 0 0 1rpx var(--c-glass-edge); }
.hero-title { font-size: 52rpx; font-weight: 700; letter-spacing: -1rpx; margin: 24rpx 0 16rpx; }
.hero-sub { font-size: 28rpx; color: var(--c-on-hero-2, var(--c-muted)); line-height: 1.8; }
.benefit { display: flex; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--c-line); }
.benefit:last-child { border-bottom: 0; }
.no { width: 64rpx; height: 64rpx; border-radius: 18rpx; background: var(--c-surface-soft); color: var(--c-ink); font-weight: 600; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.rule { line-height: 2; }

/* 主按钮放在内容流里（不再 fixed），上方留出与卡片的间距 */
.apply-cta { margin-top: 8rpx; }

/* tabBar 占位：自定义 tabBar 是 fixed 的，高度 104rpx + 底部安全区。
   这里必须留够，否则滑到底时按钮会被 tabBar 压住。 */
.tabbar-space { height: calc(104rpx + env(safe-area-inset-bottom)); }
