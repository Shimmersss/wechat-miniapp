<theme-shell>
<view class="container has-tabbar">
  <view class="hero">
    <image class="hero-deco" src="/assets/agent/hero-deco.svg" mode="aspectFill" />
    <text class="hero-tag">夏目数码代理</text>
    <view class="hero-title">不压货，也能卖手机</view>
    <view class="hero-sub">货由门店备好，你只管转发给身边的朋友。成交一台，加价就归你。</view>
    <view class="hero-slogan">{{brand.slogan}}</view>
  </view>

  <section-card title="一台手机怎么赚">
    <view class="sum">
      <view class="sum-item"><text class="sum-value">¥5,000</text><text class="sum-label">门店底价</text></view>
      <text class="sum-sign">+</text>
      <view class="sum-item"><text class="sum-value earn">¥200</text><text class="sum-label">你的加价</text></view>
      <text class="sum-sign">=</text>
      <view class="sum-item"><text class="sum-value">¥5,200</text><text class="sum-label">顾客看到的价格</text></view>
    </view>
    <view class="earn-note">成交后，这 ¥200 记到你名下</view>
    <view class="hint">金额仅为举例，底价和加价上限以门店通知为准。</view>
  </section-card>

  <section-card title="为什么好做">
    <view class="perks">
      <view wx:for="{{perks}}" wx:key="icon" class="perk">
        <image class="perk-icon" src="/assets/agent/{{item.icon}}.svg" />
        <view class="perk-title">{{item.title}}</view>
        <view class="perk-desc">{{item.desc}}</view>
      </view>
    </view>
  </section-card>

  <section-card title="怎么开始">
    <view wx:for="{{steps}}" wx:key="title" class="step">
      <view class="step-no">{{index + 1}}</view>
      <view class="flex-1">
        <view class="step-title">{{item.title}}</view>
        <view class="step-desc">{{item.desc}}</view>
      </view>
    </view>
  </section-card>

  <section-card title="先说清楚">
    <view wx:for="{{rules}}" wx:key="*this" class="rule">{{item}}</view>
  </section-card>

  <!-- 本页是 tabBar 页，底部已被自定义 tabBar 常驻占用（104rpx + 安全区）。
       不能再叠一层 position:fixed 的 footer-bar，否则按钮会被 tabBar 压住。
       改为把主按钮放回内容流末尾，并留出 tabBar 高度，滚到底自然可见。 -->
  <button class="btn btn-primary btn-block apply-cta" bindtap="onPrimaryTap">
    {{agentStatus === 'active' ? '进入代理中心' : agentStatus === 'pending' ? '已提交，等待审核' : agentStatus === 'rejected' ? '重新申请' : agentStatus === 'disabled' ? '代理资格已停用' : '申请成为代理'}}
  </button>
  <view class="tabbar-space"></view>
</view>
</theme-shell>
