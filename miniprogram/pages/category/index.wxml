<view class="layout">
  <scroll-view scroll-y class="side">
    <view wx:for="{{categories}}" wx:key="value" class="side-item {{activeIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onCategoryTap">{{item.label}}</view>
  </scroll-view>
  <scroll-view scroll-y class="main">
    <view class="chips mb">
      <view class="chip active">二手机</view>
      <view class="chip">新机</view>
    </view>
    <block wx:for="{{categories[activeIndex].brands}}" wx:for-item="brand" wx:key="value">
      <view class="brand-title">{{brand.label}}</view>
      <block wx:for="{{brand.series}}" wx:for-item="series" wx:key="label">
        <view class="series-title">{{series.label}}</view>
        <view class="model-grid">
          <view wx:for="{{series.models}}" wx:for-item="model" wx:key="*this" class="model" data-model="{{model}}" bindtap="onModelTap">{{model}}</view>
        </view>
      </block>
    </block>
    <empty-state wx:if="{{categories.length && !categories[activeIndex].brands.length}}" text="该分类暂无型号" />
  </scroll-view>
</view>
