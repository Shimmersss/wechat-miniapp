<theme-shell>
<empty-state wx:if="{{error}}" text="{{error}}" action-text="重试" bind:action="load" />
<empty-state wx:elif="{{loading && !categories.length}}" text="正在加载分类" />
<empty-state wx:elif="{{!categories.length}}" text="暂无分类" />
<view wx:else class="layout">
  <scroll-view scroll-y class="side">
    <view wx:for="{{categories}}" wx:key="value" class="side-item {{activeIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onCategoryTap">{{item.label}}</view>
  </scroll-view>
  <scroll-view scroll-y class="main">
    <view class="chips mb">
      <view class="chip {{condition === 'used' ? 'active' : ''}}" data-value="used" bindtap="onConditionTap">{{categories[activeIndex].identifierMode === 'imei' ? '二手机' : '二手'}}</view>
      <view class="chip {{condition === 'new' ? 'active' : ''}}" data-value="new" bindtap="onConditionTap">{{categories[activeIndex].identifierMode === 'imei' ? '新机' : '全新'}}</view>
    </view>
    <block wx:for="{{categories[activeIndex].brands}}" wx:for-item="brand" wx:key="value">
      <view class="brand-title">{{brand.label}}</view>
      <block wx:for="{{brand.series}}" wx:for-item="series" wx:key="label">
        <view class="series-title">{{series.label}}</view>
        <view class="model-grid">
          <view wx:for="{{series.models}}" wx:for-item="model" wx:key="name" class="model" data-id="{{model.id}}" data-name="{{model.name}}" bindtap="onModelTap">{{model.name}}</view>
        </view>
      </block>
    </block>
    <empty-state wx:if="{{categories.length && !categories[activeIndex].brands.length}}" text="该分类暂无现货" />
  </scroll-view>
</view>
</theme-shell>
