<view class="ph"></view>
<view class="dock">
  <block wx:for="{{tabs}}" wx:key="key">
    <view wx:if="{{item.key === 'plus'}}" class="mid" bindtap="onPlus">
      <view class="plus"><image class="plus-icon" src="/packages/demo/icons/plus-white.svg" /></view>
    </view>
    <view wx:else class="tab {{item.key === active ? 'on' : ''}}" data-key="{{item.key}}" data-url="{{item.url}}" bindtap="onTab">
      <image class="tab-icon" src="/packages/demo/icons/{{item.icon}}{{item.key === active ? '' : '-gray'}}.svg" />
      <text class="tab-text">{{item.text}}</text>
    </view>
  </block>
</view>
