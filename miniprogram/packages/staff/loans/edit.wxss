.segment { display: flex; padding: 6rpx; gap: 6rpx; background: var(--c-well); box-shadow: inset 0 2rpx 4rpx var(--c-hair); border-radius: var(--radius); }
.seg { flex: 1; text-align: center; line-height: 72rpx; font-size: 28rpx; color: var(--c-ink-2); border-radius: var(--radius-sm); }
.seg.on { background: var(--c-surface); color: var(--c-ink); font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.08); }
/* 错误提示也走中性样式，不再用红色 */
.notice.error { background: var(--c-surface-soft); color: var(--c-ink-2); }
.device + .device { border-top: 1rpx solid var(--c-line); padding-top: 28rpx; margin-top: 8rpx; }
.photos { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.photo image { width: 140rpx; height: 140rpx; border-radius: var(--radius-sm); background: var(--c-surface-soft); }
