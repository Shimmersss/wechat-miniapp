<wxs module="f" src="../../../utils/filters.wxs" />
<view class="container">
 <view class="notice">退款为业务记录，先确认已实际办理。此页面不会调用支付平台原路退款。</view><view wx:if="{{error}}" class="notice">{{error}}</view>
 <block wx:if="{{detail}}">
  <view class="card"><view class="h3">{{detail.no}}</view><status-pill text="{{f.label(statusMap,detail.status)}}" tone="{{f.tone(statusMap,detail.status)}}" /><view class="small muted mt-sm">{{detail.seller}} · {{detail.createdAt}} · {{detail.payMethod}}</view></view>
  <section-card title="成交快照"><view class="list-item"><text>原成交额</text><text>¥{{f.maskMoney(detail.amount,privacy)}}</text></view><view class="list-item"><text>累计退款</text><text>¥{{f.maskMoney(detail.refundAmount,privacy)}}</text></view><view class="list-item"><text>净实收</text><text>¥{{f.maskMoney(detail.netAmount,privacy)}}</text></view><view class="list-item"><text>净毛利</text><text>{{detail.profit !== undefined ? '¥'+f.maskMoney(detail.profit,privacy) : '无权限查看'}}</text></view><view class="small mt">顾客 {{detail.customer || '未填写'}} {{detail.phone}}</view><view class="small muted mt-sm">{{detail.remark}}</view></section-card>
  <section-card wx:if="{{detail.agentSources.length}}" title="代理来源"><view wx:for="{{detail.agentSources}}" wx:key="orderId" class="mb"><view class="small">来自代理 {{item.agentName || '已注销代理'}} 的分享链接</view><view class="tiny muted mt-sm">分享价 ¥{{f.maskMoney(item.sharePrice,privacy)}}{{item.markup !== undefined ? ' · 代理加价 ¥' + f.maskMoney(item.markup,privacy) : ''}}</view><view wx:for="{{item.earnings}}" wx:for-item="e" wx:key="kind" class="tiny mt-sm">{{e.kind === 'reversal' ? '退货冲回' : '成交收益'}} ¥{{f.maskMoney(e.amount,privacy)}} · {{f.label(settlementMap,e.status)}}</view></view></section-card>
  <section-card title="销售设备"><view wx:for="{{detail.items}}" wx:key="id" class="mb" data-id="{{item.unitId}}" bindtap="onUnit"><view class="h3">{{item.name}}</view><view class="small muted">{{item.spec}}</view><view class="small mt-sm">成交 ¥{{f.maskMoney(item.price,privacy)}} · 已退 ¥{{f.maskMoney(item.refunded,privacy)}} · {{item.returnable ? '未退货' : '已退货'}}</view><view class="tiny muted">成交成本 {{item.cost !== undefined ? '¥'+f.maskMoney(item.cost,privacy) : '无权限查看'}} · 库存档案 ›</view></view></section-card>
  <section-card title="收款凭证" subtitle="{{detail.receipts.length ? detail.receipts.length + ' 张' : ''}}"><view class="receipts"><image wx:for="{{detail.receipts}}" wx:key="fileId" src="{{item.url}}" data-id="{{item.fileId}}" bindtap="onPreviewReceipt" mode="aspectFill" /></view><view wx:if="{{!detail.receipts.length}}" class="muted small">未上传收款凭证</view><button wx:if="{{canReceipt}}" class="btn btn-line btn-block mt" bindtap="onAddReceipts" loading="{{uploading}}" disabled="{{uploading || saving}}">补传收款截图 / 小票照片</button></section-card>
  <section-card title="退款记录"><view wx:for="{{detail.refunds}}" wx:key="id" class="mb"><view class="small">{{item.kind === 'return' ? '退货退款' : '金额调整'}} ¥{{f.maskMoney(item.amount,privacy)}}</view><view class="tiny muted">{{item.time}} · {{item.reason}}</view></view><view wx:if="{{!detail.refunds.length}}" class="muted small">暂无退款</view></section-card>
  <button wx:if="{{canRefund && !editor && detail.status !== 'refunded'}}" class="btn btn-primary btn-block mb" bindtap="onRefund" disabled="{{saving || loading}}">登记退款 / 退货</button>
  <view wx:if="{{editor}}" class="card"><view class="h2 mb">逐台退款</view><view class="chips mb"><view class="chip {{editor.kind === 'return' ? 'active' : ''}}" data-value="return" bindtap="onKind">退货入复检</view><view class="chip {{editor.kind === 'adjustment' ? 'active' : ''}}" data-value="adjustment" bindtap="onKind">仅退差价</view></view>
   <view wx:for="{{editor.items}}" wx:key="id" class="mb"><view class="row"><text class="small">{{item.name}}</text><switch checked="{{item.selected}}" data-id="{{item.id}}" bindchange="onItem" disabled="{{saving || pending}}" /></view><input class="input mt-sm" type="digit" value="{{item.amount}}" data-id="{{item.id}}" bindinput="onAmount" placeholder="{{editor.kind === 'return' ? '留空退本台剩余可退金额' : '填写本台差价退款金额'}}" disabled="{{saving || pending}}" /></view>
   <view class="row gap-sm mt"><button class="btn btn-line" bindtap="onClose" disabled="{{saving || pending}}">取消</button><button class="btn btn-primary" bindtap="onSubmitRefund" disabled="{{saving || pending}}" loading="{{saving}}">填写原因并保存</button></view>
  </view>
  <view wx:if="{{pending}}" class="notice">提交结果未知，保持原内容重试可防止重复退款记录。<button class="btn btn-primary btn-block mt" bindtap="onRetry" loading="{{saving}}" disabled="{{saving}}">原样重试</button></view>
 </block>
</view>
