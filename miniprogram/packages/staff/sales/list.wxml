<wxs module="f" src="../../../utils/filters.wxs" />
<theme-shell>
<view class="container">
 <view class="card"><input class="input mb" placeholder="销售单号 / 顾客" value="{{keyword}}" data-field="keyword" bindinput="onInput" bindconfirm="onSearch" /><view class="grid-2"><picker mode="date" value="{{from}}" data-field="from" bindchange="onInput"><view class="picker">{{from || '开始日期'}}</view></picker><picker mode="date" value="{{to}}" data-field="to" bindchange="onInput"><view class="picker">{{to || '结束日期'}}</view></picker></view><picker range="{{sellers}}" range-key="name" value="{{sellerIndex}}" bindchange="onSellerChange"><view class="picker mt">{{sellers[sellerIndex].name}}</view></picker><view class="row gap-sm mt"><button class="btn btn-soft btn-sm" bindtap="onSearch">搜索</button><button class="btn btn-line btn-sm" bindtap="onClear">清除筛选</button></view></view>
 <scroll-view scroll-x class="mb"><view class="chips nowrap"><view wx:for="{{filters}}" wx:key="value" class="chip {{activeFilter === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onFilterTap">{{item.label}}</view></view></scroll-view>
 <view wx:if="{{error}}" class="notice">{{error}}</view>
 <view wx:for="{{list}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="onItemTap"><view class="row"><text class="h3 flex-1">{{item.unitName}}</text><status-pill text="{{f.label(statusMap,item.status)}}" tone="{{f.tone(statusMap,item.status)}}" /></view><view class="tiny muted mt-sm">{{item.no}} · {{item.seller}} · {{f.time(item.createdAt)}}</view><view class="small mt-sm">成交 ¥{{f.maskMoney(item.amount,privacy)}} · 已退 ¥{{f.maskMoney(item.refundAmount,privacy)}} · 净收 ¥{{f.maskMoney(item.netAmount,privacy)}}</view></view>
 <empty-state wx:if="{{!loading && !error && !list.length}}" text="暂无符合条件的销售单" /><view wx:if="{{loading}}" class="small muted">加载中…</view>
</view>
</theme-shell>
