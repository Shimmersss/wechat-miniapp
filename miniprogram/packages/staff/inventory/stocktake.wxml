<view class="container">
 <view wx:if="{{error}}" class="notice">{{error}}</view>
 <section-card wx:if="{{sessions.length}}" title="进行中的盘点">
  <view wx:for="{{sessions}}" wx:key="id" class="list-item" data-id="{{item.id}}" bindtap="onSession">
   <view class="flex-1"><view class="small">{{item.scope.modelName || item.scope.categoryLabel || '全部型号'}}{{item.note ? ' · ' + item.note : ''}}</view><view class="tiny muted">{{item.operator}} 开单 · {{item.timeText}}</view><view class="tiny muted">已盘 {{item.scannedCount}} / 应盘 {{item.expectedCount}} · 异常 {{item.extraCount}}</view></view><text>继续 ›</text>
  </view>
 </section-card>
 <view class="card">
  <view class="h2">新建盘点单</view>
  <view class="tiny muted mt-sm">开单时按范围生成应盘清单，之后边扫边勾，扫码记录实时保存，可中途退出、多人同时扫同一张单。盘点只记录差异，不改库存。</view>
  <view class="small mt">盘点范围</view>
  <view class="chips mt-sm"><view class="chip {{!category && !model ? 'active' : ''}}" data-value="" bindtap="onCategory">全部</view><view wx:for="{{categories}}" wx:key="value" class="chip {{category === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onCategory">{{item.label}}</view></view>
  <view class="row gap-sm mt"><button class="btn btn-soft btn-sm flex-1" bindtap="onChooseModel" disabled="{{saving || pending}}">{{model ? '型号：' + model.name : '只盘某个型号'}}</button><button wx:if="{{model}}" class="btn btn-line btn-sm" bindtap="onClearModel" disabled="{{saving || pending}}">清除</button></view>
  <view class="small mt">库存状态（只列实物在店里的状态）</view>
  <checkbox-group bindchange="onStatuses"><label wx:for="{{choices}}" wx:key="value" class="status-option"><checkbox value="{{item.value}}" checked="{{item.checked}}" disabled="{{saving || pending}}" />{{item.label}}</label></checkbox-group>
  <input class="input mt" value="{{note}}" bindinput="onNote" maxlength="200" placeholder="说明（选填），如：月底全盘、柜台A" disabled="{{saving || pending}}" />
  <button wx:if="{{!pending}}" class="btn btn-primary btn-block mt" bindtap="onStart" loading="{{saving}}" disabled="{{saving}}">开始盘点</button>
  <view wx:else class="notice mt">结果未知，保留原内容重试以防重复开单。<button class="btn btn-primary btn-block mt" bindtap="send" loading="{{saving}}" disabled="{{saving}}">原样重试</button></view>
 </view>
 <section-card title="已结束的盘点">
  <view wx:if="{{!history.length && !historyLoading}}" class="tiny muted">暂无记录</view>
  <view wx:for="{{history}}" wx:key="id" class="list-item" data-id="{{item.id}}" bindtap="onRecord">
   <view class="flex-1"><view class="small">{{item.timeText}} · {{item.operator}}{{item.scope.modelName || item.scope.categoryLabel ? ' · ' + (item.scope.modelName || item.scope.categoryLabel) : ''}}</view><view class="tiny muted">应盘 {{item.expectedCount}} · 盘到 {{item.matched}} · 缺失 {{item.missingCount}} · 异常 {{item.extraCount}}{{item.changedCount ? ' · 期间离店 ' + item.changedCount : ''}}</view></view>
   <status-pill wx:if="{{item.openCount}}" text="{{item.openCount}} 项待处理" tone="orange" /><text wx:else>›</text>
  </view>
  <button wx:if="{{historyMore}}" class="btn btn-line btn-block mt" bindtap="onMore" loading="{{historyLoading}}">加载更多</button>
 </section-card>
</view>
