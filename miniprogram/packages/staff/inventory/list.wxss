.chips.nowrap { flex-wrap: nowrap; } .chip { flex-shrink: 0; }
.age-warning { box-shadow: inset 0 0 0 2rpx var(--c-orange-soft); }
.summary { background: var(--c-glass); color: var(--c-on-hero, var(--c-ink));
  backdrop-filter: blur(22px) saturate(180%); -webkit-backdrop-filter: blur(22px) saturate(180%);
  box-shadow: var(--e3), inset 0 0 0 1rpx var(--c-glass-edge); border-radius: var(--radius-xl); }
.summary-label { font-size: 24rpx; color: var(--c-muted); }
.summary-main { display: flex; align-items: baseline; gap: 8rpx; margin-top: 4rpx; }
.summary-num { font-size: 72rpx; font-weight: 600; letter-spacing: -2rpx; line-height: 1.1; font-variant-numeric: tabular-nums; }
.summary-unit { font-size: 28rpx; color: var(--c-muted); }
.summary-money { font-size: 36rpx; font-weight: 600; letter-spacing: -0.5rpx; margin-top: 4rpx; font-variant-numeric: tabular-nums; }
.actions { display: flex; gap: 8rpx; background: var(--c-surface); border-radius: var(--radius-lg); padding: 28rpx 4rpx; box-shadow: var(--e1); }
.action { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 12rpx; font-size: 24rpx; color: var(--c-ink); white-space: nowrap; }
.action-icon { width: 88rpx; height: 88rpx; border-radius: 28rpx; background: var(--c-surface-soft); display: flex; align-items: center; justify-content: center; }
.action-icon image { width: 48rpx; height: 48rpx; }
.check { width: 40rpx; height: 40rpx; border-radius: 50%; border: 2rpx solid var(--c-ink-4); margin-right: 16rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: var(--c-on-ink); }
.check.on { background: var(--c-ink); border-color: var(--c-ink); }
.unit.picked { box-shadow: inset 0 0 0 3rpx var(--c-ink); }
.unit.unpickable { opacity: .45; }
.summary-money.na { font-size: 24rpx; font-weight: 500; color: var(--c-muted); line-height: 50rpx; }
.agent-on { color: var(--c-green); }
.notice.row { gap: 16rpx; }
