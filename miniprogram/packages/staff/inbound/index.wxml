<view class="container inbound">
  <view class="mode-tabs"><button class="{{!batch ? 'active' : ''}}" data-mode="single" bindtap="onSwitchMode" disabled="{{submitting}}">单台入库</button><button class="{{batch ? 'active' : ''}}" data-mode="batch" bindtap="onSwitchMode" disabled="{{submitting}}">批量入库</button></view>
  <view class="card">
    <view class="reference-row"><text class="row-label">设备类型</text><view class="chips"><view aria-role="button" class="type-chip {{form.condition === 'used' ? 'selected' : ''}}" data-value="used" bindtap="onCondition">二手机</view><view aria-role="button" class="type-chip {{form.condition === 'new' ? 'selected' : ''}}" data-value="new" bindtap="onCondition">新机</view></view></view>
    <view class="reference-row"><text class="row-label">设备型号</text><text class="h3 flex-1">{{model ? model.name : '扫码识别或选择型号'}}</text><button class="btn btn-line btn-sm choose-model" bindtap="onChooseModel" disabled="{{submitting || modelLoading}}">{{modelLoading ? '加载中' : '切换'}}</button></view>
    <button class="btn btn-soft btn-sm scan-identify" data-row="{{rows[0].key}}" bindtap="onScan" disabled="{{submitting}}">扫码识别型号</button>
    <view wx:if="{{model}}" class="tiny muted mt-sm">{{model.brandLabel}} / {{model.series}} · 模板 v{{templateVersion}}</view>
    <view wx:if="{{batch}}" class="reference-row"><text class="row-label">入库数量</text><text class="h3 flex-1">{{rows.length}} 台</text><button class="btn btn-soft btn-sm" bindtap="onAddRow" disabled="{{submitting || rows.length >= 100}}">增加一台</button></view>
  </view>
  <view wx:if="{{model}}" class="card"><view class="h2">{{batch ? '公共参数' : '设备参数'}}</view><template-fields fields="{{parameterFields}}" values="{{attributes}}" bindchange="onAttributeChange" bindbusy="onFieldBusy" disabled="{{submitting}}" /></view>
  <view class="card">
    <view class="row mb"><text class="h2">{{batch ? '逐台设置 IMEI' : 'IMEI1 扫码识别'}}</text><button wx:if="{{batch}}" class="btn btn-dark btn-sm scan-next" bindtap="onScan" disabled="{{submitting}}">扫码追加</button></view>
    <view wx:for="{{rows}}" wx:for-item="unit" wx:key="key" class="unit-row">
      <view wx:if="{{batch}}" class="row mb"><text class="h3">第 {{index + 1}} 台</text><button class="btn btn-line btn-sm" data-row="{{unit.key}}" bindtap="onRemoveRow" disabled="{{submitting || rows.length === 1}}">移除</button></view>
      <view class="row gap-sm"><input class="input flex-1 imei-input" type="number" maxlength="15" placeholder="IMEI1（必填）" value="{{unit.imei1}}" data-row="{{unit.key}}" data-field="imei1" bindinput="onRowInput" bindblur="onImeiBlur" disabled="{{submitting}}" /><button class="btn btn-dark btn-sm" data-row="{{unit.key}}" bindtap="onScan" disabled="{{submitting}}">扫码</button></view>
      <view class="tiny mt-sm {{unit.state === 'ok' ? 'gold' : 'muted'}}">{{unit.message || '扫码可查询已核验型号；未命中请手选，容量颜色请核对实机'}}</view>
      <input class="input mt-sm" type="number" maxlength="15" placeholder="IMEI2（选填）" value="{{unit.imei2}}" data-row="{{unit.key}}" data-field="imei2" bindinput="onRowInput" disabled="{{submitting}}" />
      <button wx:if="{{batch && model}}" class="btn btn-soft btn-sm mt" data-row="{{unit.key}}" bindtap="onToggleRow">{{unit.expanded ? '收起单台差异' : '编辑单台差异'}}</button><view wx:if="{{batch && model && unit.expanded}}" class="overrides"><view class="row mt"><text class="tiny muted">单台差异（留空沿用公共参数）</text><button class="btn btn-soft btn-sm" data-row="{{unit.key}}" bindtap="onResetOverrides" disabled="{{submitting}}">恢复公共值</button></view><template-fields fields="{{rowFields}}" values="{{unit.attributes}}" data-row="{{unit.key}}" bindchange="onRowAttribute" bindbusy="onFieldBusy" disabled="{{submitting}}" /><view class="reference-row"><text class="row-label">单台成本</text><input class="value-input flex-1" type="digit" placeholder="沿用公共成本" value="{{unit.cost}}" data-row="{{unit.key}}" data-field="cost" bindinput="onRowInput" disabled="{{submitting}}" /></view></view>
    </view>
  </view>

  <view class="card">
    <view class="row mb"><text class="h2">机况描述（同行）</text><button class="btn btn-line btn-sm" data-channel="peer" bindtap="onQuickDescription" disabled="{{submitting}}">快捷选择</button></view><textarea class="textarea" value="{{form.peerDesc}}" data-field="peerDesc" bindinput="onInput" placeholder="用于展示给同行看的机况" disabled="{{submitting}}" />
    <view class="row mt mb"><text class="h2">机况描述（顾客）</text><button class="btn btn-line btn-sm" data-channel="customer" bindtap="onQuickDescription" disabled="{{submitting}}">快捷选择</button></view><textarea class="textarea" value="{{form.customerDesc}}" data-field="customerDesc" bindinput="onInput" placeholder="用于展示给顾客看的机况" disabled="{{submitting}}" />
    <view class="field-label mt">内部备注（同行和顾客不可见）</view><textarea class="textarea" value="{{form.internalNote}}" data-field="internalNote" bindinput="onInput" disabled="{{submitting}}" />
    <view class="list-item"><text>展示在店铺</text><switch checked="{{form.flags.showInShop}}" data-flag="showInShop" bindchange="onFlagChange" disabled="{{submitting}}" /></view>
    <view class="list-item"><text>允许同行共享</text><switch checked="{{form.flags.sharePeer}}" data-flag="sharePeer" bindchange="onFlagChange" disabled="{{submitting}}" /></view>
    <view class="list-item"><text>允许代理转发</text><switch checked="{{form.flags.shareAgent}}" data-flag="shareAgent" bindchange="onFlagChange" disabled="{{submitting}}" /></view>
  </view>
  <view class="card"><view class="h2">设备照片 / 视频</view><view class="tiny muted mt-sm">公开实拍，与模板中的内部收货凭证分开上传</view><view class="media-list mt"><view wx:for="{{form.publicImages}}" wx:key="fileId" class="media"><video wx:if="{{item.mediaType === 'video'}}" src="{{item.url}}" /><image wx:else src="{{item.url}}" mode="aspectFill" /><view class="media-actions"><button data-index="{{index}}" data-action="-1" bindtap="onMediaAction" disabled="{{submitting || index === 0}}">前移</button><button data-index="{{index}}" data-action="1" bindtap="onMediaAction" disabled="{{submitting || index === form.publicImages.length - 1}}">后移</button><button data-index="{{index}}" data-action="delete" bindtap="onMediaAction" disabled="{{submitting}}">删除</button></view></view></view><button wx:if="{{form.publicImages.length < 9}}" class="btn btn-soft btn-sm mt" bindtap="onChooseMedia" loading="{{uploading}}" disabled="{{submitting || uploading}}">添加照片或视频</button></view>
  <view wx:if="{{imageFields.length}}" class="card"><template-fields fields="{{imageFields}}" values="{{attributes}}" bindchange="onAttributeChange" bindbusy="onFieldBusy" disabled="{{submitting}}" /></view>
  <view class="card"><view class="h2 mb">入库价格</view><view class="grid-3"><view><view class="field-label required">单台成本价</view><input class="input" type="digit" value="{{form.cost}}" data-field="cost" bindinput="onInput" disabled="{{submitting}}" /></view><view><view class="field-label required">单台批发价</view><input class="input" type="digit" value="{{form.wholesale}}" data-field="wholesale" bindinput="onInput" disabled="{{submitting}}" /></view><view><view class="field-label required">单台零售价</view><input class="input" type="digit" value="{{form.retail}}" data-field="retail" bindinput="onInput" disabled="{{submitting}}" /></view></view>
    <view class="chips mt"><view wx:for="{{costPresets}}" wx:key="*this" class="chip" data-cost="{{item}}" bindtap="onCostPreset">成本 ¥{{item}}</view></view>
    <view class="grid-2 mt"><view><view class="field-label required">代理结算底价</view><input class="input" type="digit" value="{{form.agentBase}}" data-field="agentBase" bindinput="onInput" disabled="{{submitting}}" /></view><view><view class="field-label">目标利润（定价辅助）</view><input class="input" type="digit" value="{{form.targetProfit}}" data-field="targetProfit" bindinput="onInput" disabled="{{submitting}}" /></view></view><view class="tiny muted mt">建议价由服务端返回，手动填写的三价不会被覆盖。</view>
  </view>
  <view class="card row"><text class="small flex-1">已逐台核对实机、串码、机况与收货凭证</text><switch checked="{{form.inspectionConfirmed}}" data-field="inspectionConfirmed" bindchange="onInput" disabled="{{submitting}}" /></view>
  <view class="footer-space"></view><view class="footer-bar"><button class="btn btn-primary submit-inbound" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting || modelLoading || uploading || fieldUploads > 0}}">{{batch ? '批量入库（' + rows.length + '台）' : '确认单台入库'}}</button></view>
</view>
