<theme-shell>
<view class="container inbound">
  <view class="mode-tabs"><button class="{{!batch ? 'active' : ''}}" data-mode="single" bindtap="onSwitchMode" disabled="{{submitting}}">单台入库</button><button class="{{batch ? 'active' : ''}}" data-mode="batch" bindtap="onSwitchMode" disabled="{{submitting}}">批量入库</button></view>
  <view wx:if="{{hasDraft}}" class="card row">
    <text class="small flex-1">本机草稿</text>
    <button class="btn btn-line btn-sm" bindtap="onDeleteDraft" disabled="{{submitting || modelLoading || uploading || fieldUploads > 0 || restoringDraft || checkingSubmission}}">删除</button>
    <button class="btn btn-soft btn-sm" bindtap="onRestoreDraft" disabled="{{submitting || modelLoading || uploading || fieldUploads > 0 || restoringDraft || checkingSubmission}}">恢复草稿</button>
  </view>
  <view class="card">
    <view class="reference-row"><text class="row-label">设备类型</text><view class="chips"><view wx:for="{{conditionOptions}}" wx:key="value" aria-role="button" class="type-chip {{form.condition === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="onCondition">{{item.label}}</view></view></view>
    <view id="field-model" class="reference-row"><text class="row-label">设备型号</text><text class="h3 flex-1">{{model ? model.name : '扫码识别或选择型号'}}</text><button class="btn btn-line btn-sm choose-model" bindtap="onChooseModel" disabled="{{submitting || modelLoading}}">{{modelLoading ? '加载中' : '切换'}}</button></view>
    <view wx:if="{{errors.model}}" class="field-error">{{errors.model}}</view>
    <button wx:if="{{identifierMode === 'imei'}}" class="btn btn-soft btn-sm scan-identify" data-row="{{rows[0].key}}" bindtap="onScan" disabled="{{submitting}}">扫码识别型号</button>
    <view wx:if="{{model}}" class="tiny muted mt-sm">{{model.brandLabel}} / {{model.series}} · 模板 v{{templateVersion}}</view>
    <view wx:if="{{batch}}" class="reference-row"><text class="row-label">入库数量</text><text class="h3 flex-1">{{rows.length}} 台</text><button class="btn btn-soft btn-sm" bindtap="onAddRow" disabled="{{submitting || rows.length >= 100}}">增加一台</button></view>
  </view>
  <view wx:if="{{model}}" id="field-parameters" class="card"><view class="h2">{{batch ? '公共参数' : '设备参数'}}</view><template-fields fields="{{parameterFields}}" values="{{attributes}}" error="{{parameterError}}" bindchange="onAttributeChange" bindbusy="onFieldBusy" disabled="{{submitting}}" /></view>
  <view wx:if="{{model && canSupplier}}" class="card"><view class="field-label {{supplierRequired ? 'required' : ''}}">供应商</view><picker range="{{suppliers}}" range-key="name" value="{{supplierIndex}}" bindchange="onSupplier"><view class="input">{{suppliers[supplierIndex].name}}</view></picker></view>
  <view class="card">
    <view class="row mb"><text class="h2">{{identifierMode === 'imei' ? (batch ? '逐台设置 IMEI' : 'IMEI1 扫码识别') : (batch ? '逐台设置序列号' : '序列号（SN）')}}</text><button wx:if="{{batch}}" class="btn btn-dark btn-sm scan-next" bindtap="onScan" disabled="{{submitting || (identifierMode !== 'imei' && batchNoSerial)}}">扫码追加</button></view>
    <block wx:if="{{identifierMode !== 'imei' && batch}}">
      <view class="list-item"><text>本批都没有序列号</text><switch checked="{{batchNoSerial}}" bindchange="onBatchNoSerial" disabled="{{submitting}}" /></view>
      <view wx:if="{{batchNoSerial}}" class="reason-box">
        <view class="chips"><view wx:for="{{reasonPresets}}" wx:key="*this" class="chip {{batchReason === item ? 'active' : ''}}" data-row="batch" data-value="{{item}}" bindtap="onReasonPreset">{{item}}</view></view>
        <input class="input mt-sm" maxlength="100" placeholder="无序列号原因（2～100字，整批共用）" value="{{batchReason}}" bindinput="onBatchReason" disabled="{{submitting}}" />
      </view>
    </block>
    <view wx:for="{{rows}}" wx:for-item="unit" wx:key="key" class="unit-row" id="identity-{{index}}"><view id="field-identity-{{index}}"></view>
      <view wx:if="{{batch}}" class="row mb"><text class="h3">第 {{index + 1}} 台</text><button class="btn btn-line btn-sm" data-row="{{unit.key}}" bindtap="onRemoveRow" disabled="{{submitting || rows.length === 1}}">移除</button></view>
      <block wx:if="{{identifierMode === 'imei'}}">
        <view class="row gap-sm"><input focus="{{identityFocus && index === 0}}" class="input flex-1 imei-input" type="number" maxlength="15" placeholder="IMEI1（必填）" value="{{unit.imei1}}" data-row="{{unit.key}}" data-field="imei1" bindinput="onRowInput" bindblur="onImeiBlur" disabled="{{submitting}}" /><button class="btn btn-dark btn-sm" data-row="{{unit.key}}" bindtap="onScan" disabled="{{submitting}}">扫码</button></view>
        <view class="tiny mt-sm {{unit.state === 'ok' ? 'gold' : 'muted'}}">{{unit.message || '扫码可查询已核验型号；未命中请手选，存储容量、运行内存和颜色请核对实机'}}</view>
        <input class="input mt-sm" type="number" maxlength="15" placeholder="IMEI2（选填）" value="{{unit.imei2}}" data-row="{{unit.key}}" data-field="imei2" bindinput="onRowInput" disabled="{{submitting}}" />
      </block>
      <block wx:else>
        <block wx:if="{{!(batch && batchNoSerial)}}">
          <view wx:if="{{!unit.noSerial}}" class="row gap-sm"><input focus="{{identityFocus && index === 0}}" class="input flex-1 serial-input" maxlength="40" placeholder="SN 码（推荐填写）" value="{{unit.serialNo}}" data-row="{{unit.key}}" data-field="serialNo" bindinput="onRowInput" bindblur="onSerialBlur" disabled="{{submitting}}" /><button class="btn btn-dark btn-sm" data-row="{{unit.key}}" bindtap="onScan" disabled="{{submitting}}">扫码</button></view>
          <view class="list-item"><text>没有序列号</text><switch checked="{{unit.noSerial}}" data-row="{{unit.key}}" bindchange="onNoSerialChange" disabled="{{submitting}}" /></view>
          <view wx:if="{{unit.noSerial}}" class="reason-box">
            <view class="chips"><view wx:for="{{reasonPresets}}" wx:for-item="reason" wx:key="*this" class="chip {{unit.noSerialReason === reason ? 'active' : ''}}" data-row="{{unit.key}}" data-value="{{reason}}" bindtap="onReasonPreset">{{reason}}</view></view>
            <input class="input mt-sm" maxlength="100" placeholder="无序列号原因（2～100字）" value="{{unit.noSerialReason}}" data-row="{{unit.key}}" data-field="noSerialReason" bindinput="onRowInput" bindblur="onSerialBlur" disabled="{{submitting}}" />
          </view>
        </block>
        <input wx:if="{{identifierMode === 'serial_imei'}}" class="input mt-sm" type="number" maxlength="15" placeholder="IMEI（选填，蜂窝版填写）" value="{{unit.imei1}}" data-row="{{unit.key}}" data-field="imei1" bindinput="onRowInput" bindblur="onImeiBlur" disabled="{{submitting}}" />
        <view class="tiny mt-sm {{unit.state === 'ok' ? 'gold' : 'muted'}}">{{unit.message || '同一型号下序列号不能重复；没有序列号请说明原因'}}</view>
        <view wx:if="{{!batch && unit.noSerial && !unit.imei1}}" id="field-quantity" class="reference-row"><text class="row-label">入库数量</text><input class="value-input flex-1" type="number" maxlength="3" placeholder="1～{{quantityLimit}}" value="{{quantity}}" bindinput="onQuantity" disabled="{{submitting}}" /><text class="tiny muted">件，同批共用参数与价格</text></view><view wx:if="{{errors.quantity}}" class="field-error">{{errors.quantity}}</view>
      </block>
      <view wx:if="{{errors['identity-' + index]}}" class="field-error">{{errors['identity-' + index]}}</view>
      <button wx:if="{{batch && model}}" class="btn btn-soft btn-sm mt" data-row="{{unit.key}}" bindtap="onToggleRow">{{unit.expanded ? '收起单台差异' : '编辑单台差异'}}</button><view wx:if="{{batch && model && unit.expanded}}" class="overrides"><view class="row mt"><text class="tiny muted">单台差异（留空沿用公共参数）</text><button class="btn btn-soft btn-sm" data-row="{{unit.key}}" bindtap="onResetOverrides" disabled="{{submitting}}">恢复公共值</button></view><template-fields fields="{{rowFields}}" values="{{unit.attributes}}" data-row="{{unit.key}}" bindchange="onRowAttribute" bindbusy="onFieldBusy" disabled="{{submitting}}" /><view class="reference-row"><text class="row-label">单台成本</text><input class="value-input flex-1" type="digit" placeholder="沿用公共成本" value="{{unit.cost}}" data-row="{{unit.key}}" data-field="cost" bindinput="onRowInput" disabled="{{submitting}}" /></view></view>
    </view>
  </view>

  <view wx:if="{{model && canSupplier}}" class="card"><view class="field-label {{supplierRequired ? 'required' : ''}}">供应商</view><picker range="{{suppliers}}" range-key="name" value="{{supplierIndex}}" bindchange="onSupplier"><view class="input">{{suppliers[supplierIndex].name}}</view></picker></view>
  <view class="card">
    <view class="row mb"><text class="h2">机况描述（同行）</text><button class="btn btn-line btn-sm" data-channel="peer" bindtap="onQuickDescription" disabled="{{submitting}}">快捷选择</button></view><textarea class="textarea" value="{{form.peerDesc}}" data-field="peerDesc" bindinput="onInput" placeholder="用于展示给同行看的机况" disabled="{{submitting}}" />
    <view class="row mt mb"><text class="h2">机况描述（顾客）</text><button class="btn btn-line btn-sm" data-channel="customer" bindtap="onQuickDescription" disabled="{{submitting}}">快捷选择</button></view><textarea class="textarea" value="{{form.customerDesc}}" data-field="customerDesc" bindinput="onInput" placeholder="用于展示给顾客看的机况" disabled="{{submitting}}" />
    <view class="field-label mt">内部备注（同行和顾客不可见）</view><textarea class="textarea" value="{{form.internalNote}}" data-field="internalNote" bindinput="onInput" disabled="{{submitting}}" />
    <view class="list-item"><text>展示在店铺</text><switch checked="{{form.flags.showInShop}}" data-flag="showInShop" bindchange="onFlagChange" disabled="{{submitting}}" /></view>
    <view class="list-item"><text>允许同行共享</text><switch checked="{{form.flags.sharePeer}}" data-flag="sharePeer" bindchange="onFlagChange" disabled="{{submitting}}" /></view>
    <view class="list-item"><text>允许代理转发</text><switch checked="{{form.flags.shareAgent}}" data-flag="shareAgent" bindchange="onFlagChange" disabled="{{submitting}}" /></view>
  </view>
  <view class="card"><view class="h2">设备照片 / 视频</view><view class="tiny muted mt-sm">公开实拍，与模板中的内部收货凭证分开上传</view><view class="media-list mt"><view wx:for="{{form.publicImages}}" wx:key="fileId" class="media"><video wx:if="{{item.mediaType === 'video'}}" src="{{item.url}}" /><image lazy-load="{{true}}" wx:else src="{{item.url}}" mode="aspectFill" /><view class="media-actions"><button data-index="{{index}}" data-action="-1" bindtap="onMediaAction" disabled="{{submitting || index === 0}}">前移</button><button data-index="{{index}}" data-action="1" bindtap="onMediaAction" disabled="{{submitting || index === form.publicImages.length - 1}}">后移</button><button data-index="{{index}}" data-action="delete" bindtap="onMediaAction" disabled="{{submitting}}">删除</button></view></view></view><button wx:if="{{form.publicImages.length < 9}}" class="btn btn-soft btn-sm mt" bindtap="onChooseMedia" loading="{{uploading}}" disabled="{{submitting || uploading}}">添加照片或视频</button></view>
  <view wx:if="{{imageFields.length}}" class="card"><template-fields fields="{{imageFields}}" values="{{attributes}}" error="{{parameterError}}" bindchange="onAttributeChange" bindbusy="onFieldBusy" disabled="{{submitting}}" /></view>
  <view class="card"><view class="h2 mb">入库价格</view>
    <view class="field-label required">单台成本价</view><view id="field-cost"><input class="input" type="digit" value="{{form.cost}}" data-field="cost" bindinput="onInput" disabled="{{submitting}}" /><view wx:if="{{errors.cost}}" class="field-error">{{errors.cost}}</view></view>
    <view class="chips mt"><view wx:for="{{costPresets}}" wx:key="*this" class="chip" data-cost="{{item}}" bindtap="onCostPreset">成本 ¥{{item}}</view></view>
    <view class="grid-2 mt"><view><view class="field-label">零售利润</view><input class="input" type="digit" placeholder="—" value="{{form.retailProfit}}" data-field="retailProfit" bindinput="onInput" disabled="{{submitting}}" /></view><view><view class="field-label required">零售价</view><view id="field-retail"><input class="input" type="digit" value="{{form.retail}}" data-field="retail" bindinput="onInput" disabled="{{submitting}}" /><view wx:if="{{errors.retail}}" class="field-error">{{errors.retail}}</view></view></view></view>
    <view class="grid-2 mt"><view><view class="field-label">批发利润</view><input class="input" type="digit" placeholder="—" value="{{form.wholesaleProfit}}" data-field="wholesaleProfit" bindinput="onInput" disabled="{{submitting}}" /></view><view><view class="field-label required">批发价</view><view id="field-wholesale"><input class="input" type="digit" value="{{form.wholesale}}" data-field="wholesale" bindinput="onInput" disabled="{{submitting}}" /><view wx:if="{{errors.wholesale}}" class="field-error">{{errors.wholesale}}</view></view></view></view>
    <view class="grid-2 mt"><view><view class="field-label">代理利润（选填，默认随批发）</view><input class="input" type="digit" placeholder="—" value="{{form.agentProfit}}" data-field="agentProfit" bindinput="onInput" disabled="{{submitting}}" /></view><view><view class="field-label required">代理结算底价</view><view id="field-agentBase"><input class="input" type="digit" value="{{form.agentBase}}" data-field="agentBase" bindinput="onInput" disabled="{{submitting}}" /><view wx:if="{{errors.agentBase}}" class="field-error">{{errors.agentBase}}</view></view></view></view>
  </view>
  <view class="tiny muted mt">其他字段的必填设置可在“型号模板”页调整。</view>
  <view class="footer-space"></view>
  <view class="footer-bar">
    <button class="btn btn-line" bindtap="onSaveDraft" disabled="{{submitting || modelLoading || uploading || fieldUploads > 0 || restoringDraft || checkingSubmission}}">存草稿</button>
    <button class="btn btn-primary submit-inbound" bindtap="onSubmit" loading="{{submitting || checkingSubmission}}" disabled="{{submitting || modelLoading || uploading || fieldUploads > 0 || restoringDraft || checkingSubmission}}">{{batch ? '批量入库（' + rows.length + '台）' : (identifierMode !== 'imei' && rows[0].noSerial && !rows[0].imei1 && quantity > 1 ? '按数量入库（' + quantity + '件）' : '确认单台入库')}}</button>
  </view>
</view>
<view wx:if="{{successResult}}" class="success-mask" catchtouchmove="onBlockTouch">
  <view class="card success-dialog" aria-role="dialog" aria-label="入库成功">
    <view class="h2">入库成功</view><view class="small muted mt">已保存 {{successResult.created}} 件设备与模板快照</view>
    <button class="btn btn-primary btn-block mt" bindtap="onRepeat" disabled="{{submitting}}">{{batch ? '再入一批同款' : '再入一台同款'}}</button>
    <button class="btn btn-line btn-block mt" bindtap="onDone">完成</button>
  </view>
</view>
</theme-shell>
