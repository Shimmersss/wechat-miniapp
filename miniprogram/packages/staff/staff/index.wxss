.notice.error { background: var(--c-red-soft); color: var(--c-red); }
.actions { display: flex; background: var(--c-surface); border-radius: var(--radius-lg); padding: 28rpx 4rpx; }
.action { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 12rpx; font-size: 24rpx; color: var(--c-ink); }
.action-icon { width: 88rpx; height: 88rpx; border-radius: 28rpx; background: var(--c-surface-soft); display: flex; align-items: center; justify-content: center; }
.action-icon image { width: 46rpx; height: 46rpx; }
