<wxs module="f" src="../../../utils/filters.wxs" />
<view class="container">
  <todo-block items="{{todos}}" />

  <view wx:for="{{list}}" wx:key="id" class="card">
    <view class="row">
      <text class="h3 ellipsis flex-1">{{item.operator}} · {{item.action}}</text>
      
    </view>
    <view class="row mt-sm">
      <text class="small muted">{{item.detail}}</text>
      <text class="small">{{item.time}}</text>
    </view>
  </view>

  <empty-state wx:if="{{!loading && !list.length}}" />
</view>
