<theme-shell>
<view class="container">
  <view class="card filters">
    <picker range="{{actions}}" value="{{actionIndex}}" bindchange="onAction"><view class="picker">{{actions[actionIndex]}}</view></picker>
    <picker range="{{actors}}" range-key="name" value="{{actorIndex}}" bindchange="onActor"><view class="picker">{{actors[actorIndex].name}}</view></picker>
    <view class="grid-2">
      <picker mode="date" value="{{from}}" data-field="from" bindchange="onDate"><view class="picker">{{from || '开始日期'}}</view></picker>
      <picker mode="date" value="{{to}}" data-field="to" bindchange="onDate"><view class="picker">{{to || '结束日期'}}</view></picker>
    </view>
    <view class="row"><text class="tiny muted">共 {{total}} 条</text><text class="small muted" bindtap="onClear">清除筛选</text></view>
  </view>
  <view wx:if="{{error}}" class="notice">{{error}}</view>

  <view wx:for="{{list}}" wx:key="id" class="card log" data-id="{{item.id}}" bindtap="onExpand">
    <view class="row"><text class="h3 ellipsis flex-1">{{item.action}}</text><text class="tiny muted">{{item.timeText}}</text></view>
    <view class="small muted mt-sm ellipsis">{{item.actorName}}{{item.actorRole ? '（' + item.actorRole + '）' : ''}} · {{item.objectId}}</view>
    <view wx:if="{{item.reason}}" class="small mt-sm">原因：{{item.reason}}</view>
    <view wx:if="{{expanded === item.id}}" class="detail">
      <view wx:if="{{item.beforeText}}"><view class="tiny muted">改前</view><text class="code" user-select>{{item.beforeText}}</text></view>
      <view wx:if="{{item.afterText}}" class="mt-sm"><view class="tiny muted">改后</view><text class="code" user-select>{{item.afterText}}</text></view>
      <view class="tiny muted mt-sm">IP {{item.ip}} · 请求 {{item.requestId}}</view>
    </view>
  </view>
  <empty-state wx:if="{{!loading && !error && !list.length}}" text="暂无符合条件的日志" />
</view>
</theme-shell>
