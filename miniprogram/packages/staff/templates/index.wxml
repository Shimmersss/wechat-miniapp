<theme-shell>
<view class="container">
  <view wx:if="{{selecting}}" class="notice mb">选择标准型号，使用所属分类的入库模板和该型号的规格选项。</view>
  <view wx:else class="row gap-sm mb"><button class="btn btn-soft btn-sm add-category" bindtap="onAddCategory">新增分类</button><button class="btn btn-line btn-sm" bindtap="onRenameCategory">修改分类名</button><button class="btn btn-primary btn-sm add-model" bindtap="onAddModel" disabled="{{loading}}">新增型号</button></view>
  <scroll-view scroll-x class="mb"><view class="chips nowrap"><view wx:for="{{filters}}" wx:key="value" class="chip {{activeFilter === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onFilterTap">{{item.label}}</view></view></scroll-view>
  <view class="search-bar model-search"><image lazy-load="{{true}}" class="search-icon" src="/assets/icons/search-gray.svg" /><input class="flex-1" value="{{keyword}}" placeholder="搜索型号或系列，如 Mate 60" confirm-type="search" bindinput="onKeywordInput" /><text wx:if="{{keyword}}" class="small muted" bindtap="onClearKeyword">清除</text></view>
  <scroll-view wx:if="{{brands.length && !keyword}}" scroll-x class="mb"><view class="chips nowrap"><view wx:for="{{brands}}" wx:key="brand" class="chip {{activeBrand === item.brand ? 'active' : ''}}" data-brand="{{item.brand}}" bindtap="onBrandTap">{{item.brandLabel}} {{item.count}}</view></view></scroll-view>
  <text wx:if="{{searching}}" class="tiny muted">正在加载型号…</text>
  <view wx:if="{{error}}" class="notice">{{error}}<button class="btn btn-line btn-sm" bindtap="onRetry">重试</button></view><text wx:if="{{loading}}" class="muted">加载中…</text>
  <view wx:if="{{!selecting && categoryTemplate}}" class="card template-card" bindtap="onTemplateTap"><view class="row"><text class="h3 flex-1">{{categoryTemplate.name}}</text><text class="small">v{{categoryTemplate.version}} · 配置字段 ›</text></view><view class="tiny muted mt-sm">本分类所有型号共用这套入库模板，共 {{categoryTemplate.fields.length}} 个字段。发布新版本后对之后入库生效，已入库设备保留入库时的快照。容量和颜色在各型号里单独配置。</view></view>
  <section-card wx:for="{{tree}}" wx:key="id" title="{{item.name}}"><view wx:for="{{item.series}}" wx:for-item="series" wx:key="name"><view class="small muted mt">{{series.name}}</view><view wx:for="{{series.models}}" wx:for-item="model" wx:key="id" class="list-item" data-id="{{model.id}}" bindtap="onSelectModel"><view class="flex-1"><view>{{model.name}}</view><view wx:if="{{model.specText}}" class="tiny muted">{{model.specText}}</view></view><text class="gold">{{selecting ? '选择' : '编辑型号'}} ›</text></view></view></section-card>
  <empty-state wx:if="{{!loading && !searching && !error && !tree.length}}" title="{{keyword ? '没有找到匹配的型号' : '该分类暂无型号'}}" text="{{keyword ? '换个关键词试试，或由管理员新增型号' : '管理员可新增型号，并配置该型号的规格选项'}}" />
  <view wx:if="{{categoryEditor || modelEditor}}" class="catalog-mask"><scroll-view scroll-y class="catalog-panel">
    <block wx:if="{{categoryEditor}}"><view class="h2 mb">{{categoryEditor.id ? '修改分类' : '新增分类'}}</view><input class="input category-name" placeholder="如 游戏掌机、数码配件" value="{{categoryEditor.label}}" bindinput="onCategoryInput" maxlength="50" disabled="{{saving}}" /><view wx:if="{{!categoryEditor.id}}" class="field mt"><view class="field-label required">复制哪套模板作为起点</view><picker range="{{baseTemplates}}" range-key="name" value="{{categoryEditor.baseIndex}}" bindchange="onBasePick" disabled="{{saving}}"><view class="input">{{baseTemplates[categoryEditor.baseIndex].name}} ▾</view></picker><view class="tiny muted mt-sm">新分类会得到一份独立的分类模板，之后可以在模板里增删字段，不影响原分类。</view></view><view class="field mt"><view class="field-label required">入库串码方式</view><picker range="{{identifierModes}}" range-key="label" value="{{categoryEditor.modeIndex}}" bindchange="onModePick" disabled="{{saving || categoryEditor.locked}}"><view class="input">{{identifierModes[categoryEditor.modeIndex].label}} ▾</view></picker><view class="tiny muted mt-sm">{{categoryEditor.locked ? '该分类下已有设备，不能修改串码方式。' : '手机按 IMEI 入库；其他设备推荐填序列号，没有时说明原因。'}}</view></view><view class="row gap-sm mt"><button class="btn btn-line" bindtap="onCloseEditor" disabled="{{saving}}">取消</button><button class="btn btn-primary save-category" bindtap="onSaveCategory" loading="{{saving}}" disabled="{{saving}}">保存分类</button></view></block>
    <block wx:if="{{modelEditor}}"><view class="h2 mb">{{modelEditor.id ? '编辑型号' : '新增型号'}}</view>
      <view class="field"><view class="field-label required">分类</view><picker range="{{filters}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryPick" disabled="{{saving || modelOptionsLoading}}"><view class="input">{{filters[categoryIndex].label}} ▾</view></picker></view>
      <view class="field">
        <view class="field-label required">品牌</view>
        <picker range="{{brandOptions}}" range-key="brandLabel" value="{{modelEditor.brandIndex}}" bindchange="onModelBrandPick" disabled="{{saving || modelOptionsLoading}}">
          <view class="input">{{brandOptions[modelEditor.brandIndex].brandLabel}} ▾</view>
        </picker>
        <input wx:if="{{!modelEditor.brandId}}" class="input mt-sm" value="{{modelEditor.brandLabel}}" data-field="brandLabel" bindinput="onModelInput" placeholder="输入新品牌名称" maxlength="50" disabled="{{saving || modelOptionsLoading}}" />
      </view>
      <view class="field">
        <view class="field-label required">系列</view>
        <picker wx:if="{{modelEditor.brandId && seriesOptions.length > 1}}" range="{{seriesOptions}}" value="{{modelEditor.seriesIndex}}" bindchange="onModelSeriesPick" disabled="{{saving || modelOptionsLoading}}">
          <view class="input">{{seriesOptions[modelEditor.seriesIndex]}} ▾</view>
        </picker>
        <input wx:if="{{!modelEditor.seriesIndex}}" class="input {{seriesOptions.length > 1 ? 'mt-sm' : ''}}" value="{{modelEditor.series}}" data-field="series" bindinput="onModelInput" placeholder="{{modelOptionsLoading ? '正在加载系列…' : '输入新系列名称'}}" maxlength="50" disabled="{{saving || modelOptionsLoading}}" />
      </view>
      <view wx:if="{{modelOptionsError}}" class="row gap-sm mb"><text class="small flex-1">{{modelOptionsError}}</text><button class="btn btn-line btn-sm" bindtap="onReloadModelOptions" disabled="{{saving || modelOptionsLoading}}">重试</button></view>
      <view class="field"><view class="field-label required">标准型号</view><input class="input" value="{{modelEditor.name}}" data-field="name" bindinput="onModelInput" maxlength="50" disabled="{{saving}}" /></view>
      <view class="field"><view class="field-label">存储容量选项（每行一个，如 256G）</view><textarea class="textarea spec-text" value="{{modelEditor.storageText}}" data-field="storageText" bindinput="onModelInput" maxlength="600" disabled="{{saving}}" /></view>
      <view wx:if="{{modelEditor.ramSupported}}" class="field"><view class="field-label">运行内存选项（每行一个，如 8GB）</view><textarea class="textarea spec-text" value="{{modelEditor.ramText}}" data-field="ramText" bindinput="onModelInput" placeholder="留空沿用分类模板选项" maxlength="600" disabled="{{saving}}" /></view>
      <view class="field"><view class="field-label">颜色选项（每行一个，如 深蓝色）</view><textarea class="textarea spec-text" value="{{modelEditor.colorText}}" data-field="colorText" bindinput="onModelInput" maxlength="600" disabled="{{saving}}" /><view class="tiny muted mt-sm">入库使用该型号的规格选项，留空的项目沿用分类模板。</view></view>
      <view class="field"><view class="field-label">已核验 TAC（IMEI 前 8 位，每行一个，选填）</view><textarea class="textarea" value="{{modelEditor.tacsText}}" data-field="tacsText" bindinput="onModelInput" maxlength="1000" disabled="{{saving}}" /><view class="tiny muted mt-sm">只填写已核验的数据。留空不影响手动选择型号，不会自动从历史入库学习型号。</view></view>
      <view class="field"><view class="field-label">核验来源（填写 TAC 时必填）</view><input class="input" value="{{modelEditor.tacSource}}" data-field="tacSource" bindinput="onModelInput" maxlength="200" disabled="{{saving}}" /></view>
      <view class="row gap-sm">
        <button wx:if="{{modelEditor.id}}" class="btn btn-danger" bindtap="onDeleteModel" disabled="{{saving}}">删除型号</button>
        <button class="btn btn-line" bindtap="onCloseEditor" disabled="{{saving}}">取消</button>
        <button class="btn btn-primary save-model" bindtap="onSaveModel" loading="{{saving}}" disabled="{{saving || modelOptionsLoading}}">保存型号</button>
      </view>
    </block>
  </scroll-view></view>
</view>
</theme-shell>
