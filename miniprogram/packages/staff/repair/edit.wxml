<theme-shell>
<view class="container">
 <view wx:if="{{error}}" class="notice">{{error}}</view>
 <view wx:if="{{result}}" class="card"><view class="h2">维修单已保存</view><view class="mt">{{result.no}}</view><button class="btn btn-primary mt" bindtap="onDetail">查看维修单</button></view>
 <block wx:else>
  <view class="notice">{{form.kind === 'inventory' ? '本店设备送修会关闭分享并退出可售库存，完工后仍需独立复检。' : '外部送修机仅建维修档案，不进入门店可售库存。'}} 不记录开机密码。</view>
  <view class="card"><block wx:if="{{form.kind === 'external'}}"><view class="field"><view class="field-label required">顾客/同行联系人</view><input class="input" data-field="customer" value="{{form.customer}}" bindinput="onInput" maxlength="100" disabled="{{pending || saving || uploading}}" /></view><view class="field"><view class="field-label required">联系电话</view><input class="input" type="number" data-field="phone" value="{{form.phone}}" bindinput="onInput" maxlength="11" disabled="{{pending || saving || uploading}}" /></view><view class="field"><view class="field-label required">设备型号</view><input class="input" data-field="model" value="{{form.model}}" bindinput="onInput" maxlength="120" disabled="{{pending || saving || uploading}}" /></view><view class="field"><view class="field-label">IMEI / 序列号（选填）</view><input class="input" data-field="identifier" value="{{form.identifier}}" bindinput="onInput" maxlength="80" disabled="{{pending || saving || uploading}}" /></view></block><view wx:else class="h3 mb">{{form.model}} {{unit.storage}} · {{unit.imeiMasked}}</view>
   <view class="field"><view class="field-label required">故障描述</view><textarea class="textarea" data-field="fault" value="{{form.fault}}" bindinput="onInput" maxlength="2000" disabled="{{pending || saving || uploading}}" /></view><view wx:if="{{canAssign}}" class="field"><view class="field-label">分派工程师</view><picker range="{{engineers}}" range-key="name" value="{{engineerIndex}}" bindchange="onEngineer" disabled="{{pending || saving || uploading}}"><view class="picker">{{engineers[engineerIndex].name || '加载中'}}</view></picker></view><view class="field"><view class="field-label">预计完成日期（选填）</view><picker mode="date" data-field="expectedAt" value="{{form.expectedAt}}" bindchange="onInput" disabled="{{pending || saving || uploading}}"><view class="picker">{{form.expectedAt || '选择日期'}}</view></picker></view>
  </view>
  <section-card title="外观照片 · 仅内部可见"><view class="chips"><view wx:for="{{form.photos}}" wx:key="fileId"><image class="repair-photo" src="{{item.url}}" mode="aspectFill" /><view class="tiny gold" data-index="{{index}}" bindtap="onRemovePhoto">移除</view></view></view><button class="btn btn-line mt" bindtap="onPhotos" disabled="{{pending || saving || uploading || form.photos.length >= 9}}" loading="{{uploading}}">添加外观照片</button></section-card>
  <view wx:if="{{pending}}" class="notice">结果尚未确认，保留原内容重试以免重复建单。<button class="btn btn-primary mt" loading="{{saving}}" disabled="{{saving}}" bindtap="onRetry">原样重试</button></view><button wx:else class="btn btn-primary" bindtap="onSubmit" loading="{{saving}}" disabled="{{loading || saving || uploading}}">保存维修单</button>
 </block>
</view>
</theme-shell>
