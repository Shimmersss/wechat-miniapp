<wxs module="f" src="../../../utils/filters.wxs" />
<view class="container">
 <view wx:if="{{error}}" class="notice">{{error}}<button wx:if="{{!pending && !editor}}" class="btn btn-line mt" bindtap="onSearch">重试加载</button></view>
 <view class="row gap-sm mb"><input class="input flex-1" value="{{keyword}}" bindinput="onKeyword" bindconfirm="onSearch" placeholder="配件名称 / SKU" disabled="{{saving || confirming || pending || editor}}"/><button class="btn btn-line" bindtap="onSearch" disabled="{{saving || confirming || pending || editor}}">查找</button></view>
 <button wx:if="{{canManage}}" class="btn btn-primary mb" bindtap="onCreate" disabled="{{loading || saving || confirming || pending || editor}}">新增配件</button>
 <view wx:if="{{editor}}" class="card" id="parts-editor"><view class="row mb"><text class="h2">{{editor.title}}</text><button class="btn btn-line btn-sm" bindtap="onClose" disabled="{{saving || confirming || pending}}">关闭</button></view>
  <view wx:if="{{editor.conflict}}" class="notice">配件已变化，请刷新核对。<button class="btn btn-line mt" bindtap="onRefresh">关闭并刷新</button></view>
  <block wx:if="{{editor.kind === 'create'}}"><view class="field"><view class="field-label required">唯一SKU</view><input class="input" data-field="sku" value="{{editor.values.sku}}" bindinput="onInput" maxlength="80" disabled="{{saving || confirming || pending || editor.conflict}}" /></view><view class="field"><view class="field-label required">配件名称</view><input class="input" data-field="name" value="{{editor.values.name}}" bindinput="onInput" maxlength="120" disabled="{{saving || confirming || pending || editor.conflict}}" /></view><view class="field"><view class="field-label required">计量单位</view><input class="input" data-field="unit" value="{{editor.values.unit}}" bindinput="onInput" maxlength="20" disabled="{{saving || confirming || pending || editor.conflict}}" /></view></block>
  <block wx:else><view class="small mb">{{editor.part.name}} · {{editor.part.sku}} · 当前库存 {{editor.part.quantity}}{{editor.part.unit}}</view><view class="field"><view class="field-label required">本次到货数量</view><input class="input" type="number" data-field="quantity" value="{{editor.values.quantity}}" bindinput="onInput" disabled="{{saving || confirming || pending || editor.conflict}}" /></view><view class="field"><view class="field-label required">采购单价（元，可为0）</view><input class="input" type="digit" data-field="unitCost" value="{{editor.values.unitCost}}" bindinput="onInput" disabled="{{saving || confirming || pending || editor.conflict}}" /></view></block>
  <button wx:if="{{!pending}}" class="btn btn-primary" bindtap="onSubmit" loading="{{saving || confirming}}" disabled="{{saving || confirming || editor.conflict}}">{{editor.kind === 'create' ? '保存配件' : '填写说明并入库'}}</button>
 </view>
 <view wx:if="{{pending}}" class="notice">结果尚未确认，已保留原内容。请原样重试，避免重复入库。<button class="btn btn-primary mt" bindtap="onRetry" loading="{{saving}}" disabled="{{saving || confirming}}">原样重试</button></view>
 <view wx:for="{{list}}" wx:key="id" class="card"><view class="row"><text class="h3">{{item.name}}</text><text class="gold">{{item.quantity}}{{item.unit}}</text></view><view class="tiny muted mt-sm">{{item.sku}} · {{item.active ? '启用' : '停用'}}</view><view class="small mt">库存成本：{{item.stockValue !== undefined ? '¥'+f.maskMoney(item.stockValue,privacy) : '无权限查看'}}</view><view class="chips mt"><button wx:if="{{canManage && item.active}}" class="btn btn-line btn-sm" data-id="{{item.id}}" bindtap="onReceive" disabled="{{loading || saving || confirming || pending || editor}}">采购入库</button><button class="btn btn-line btn-sm" data-id="{{item.id}}" bindtap="onLedger" disabled="{{saving || confirming || pending || editor}}">查看流水</button></view></view>
 <empty-state wx:if="{{!loading && !error && !list.length}}" text="没有匹配的配件"/><button wx:if="{{more}}" class="btn btn-line mb" bindtap="onMore" loading="{{loading}}" disabled="{{loading || saving || confirming || pending || editor}}">加载更多配件</button>
 <section-card wx:if="{{ledger}}" title="{{ledger.name+' · 库存流水'}}"><view wx:for="{{ledger.list}}" wx:key="id" class="list-item"><view>{{ledgerLabels[item.kind]}} × {{item.quantity}}<view class="tiny muted mt-sm">{{item.timeLabel}} {{item.operator}}</view><view wx:if="{{item.reason}}" class="small muted mt-sm">{{item.reason}}</view></view><text class="small">{{item.cost !== undefined ? '¥'+f.maskMoney(item.cost,privacy) : '无权限查看成本'}}</text></view><view wx:if="{{!ledger.list.length && !ledgerLoading}}" class="small muted">暂无流水</view><button wx:if="{{ledger.more}}" class="btn btn-line mt" bindtap="onMoreLedger" loading="{{ledgerLoading}}" disabled="{{ledgerLoading || saving || confirming || pending}}">更多流水</button></section-card>
</view>
