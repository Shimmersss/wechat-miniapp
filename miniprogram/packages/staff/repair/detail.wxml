<wxs module="f" src="../../../utils/filters.wxs" />
<theme-shell>
<view class="container">
 <view wx:if="{{error}}" class="notice">{{error}}<button wx:if="{{!pending && !editor}}" class="btn btn-line mt" bindtap="load">重试加载</button></view>
 <block wx:if="{{detail}}">
  <view class="card"><view class="row"><text class="h2">{{detail.model}}</text><status-pill text="{{f.label(statusMap,detail.status)}}" tone="{{f.tone(statusMap,detail.status)}}" /></view><view class="tiny muted mt-sm">{{detail.no}} · {{detail.kind === 'inventory' ? '本店库存送修' : '外部送修'}}</view><view class="small mt">{{detail.fault}}</view><view class="small muted mt-sm">{{detail.customer || '本店维修'}} {{detail.phone}} · {{detail.engineer}}</view><view class="tiny muted mt-sm">{{detail.identifier !== undefined ? detail.identifier : detail.imeiMasked}}</view></view>
  <view class="card"><view class="grid-2"><metric-item label="当前维修报价" value="{{detail.quote !== null ? '¥'+f.maskMoney(detail.quote,privacy) : '待报价'}}" /><metric-item label="对客已收净额" value="¥{{f.maskMoney(detail.received,privacy)}}" /></view><view class="tiny muted mt">{{detail.quote !== null ? (detail.confirmedVersion === detail.quoteVersion ? '当前报价已确认' : '当前报价尚未确认') : '报价后再记录确认'}} · 报价版本 {{detail.quoteVersion}}</view><view class="chips mt"><button wx:if="{{canEdit}}" class="btn btn-line btn-sm" bindtap="onEdit" disabled="{{editor || saving || pending || loading}}">检测与资料</button><button wx:if="{{canQuote}}" class="btn btn-line btn-sm" bindtap="onQuote" disabled="{{editor || saving || pending || loading}}">{{detail.quote === null ? '维修报价' : '修改报价'}}</button><button wx:if="{{canConfirm}}" class="btn btn-primary btn-sm" bindtap="onConfirmQuote" disabled="{{editor || saving || pending || loading}}">记录报价确认</button></view><view class="chips mt"><button wx:for="{{transitions}}" wx:key="to" class="btn btn-line btn-sm" data-to="{{item.to}}" bindtap="onTransition" disabled="{{editor || saving || pending || loading}}">{{item.to === 'cancelled' ? '取消维修' : '转为'+item.label}}</button></view></view>
 </block>
 <view wx:if="{{editor}}" id="repair-editor" class="card editor-card">
  <view class="row mb"><text class="h2">{{editor.title}}</text><button class="btn btn-line btn-sm" bindtap="onClose" disabled="{{saving || confirming || pending || uploading}}">关闭</button></view>
  <view wx:if="{{editor.conflict}}" class="notice">记录已发生变化，请刷新并重新核对。<button class="btn btn-line mt" bindtap="onRefresh">关闭并刷新</button></view>
  <block wx:if="{{editor.kind === 'update'}}">
   <view class="field"><view class="field-label">故障描述</view><textarea class="textarea" value="{{editor.values.fault}}" data-field="fault" bindinput="onInput" maxlength="2000" disabled="{{saving || confirming || pending || uploading || editor.conflict}}" /></view>
   <view class="field"><view class="field-label">检测结果</view><textarea class="textarea" value="{{editor.values.diagnosis}}" data-field="diagnosis" bindinput="onInput" maxlength="2000" placeholder="记录检测依据和拟维修方案" disabled="{{saving || confirming || pending || uploading || editor.conflict}}" /></view>
   <view class="row mb"><text>等待配件</text><switch checked="{{editor.values.waitingParts}}" data-field="waitingParts" bindchange="onInput" disabled="{{saving || confirming || pending || uploading || editor.conflict}}" /></view>
   <picker mode="date" value="{{editor.values.expectedAt}}" data-field="expectedAt" bindchange="onInput" disabled="{{saving || confirming || pending || uploading || editor.conflict}}"><view class="picker mb">{{editor.values.expectedAt || '预计完成日期（选填）'}}</view></picker>
   <block wx:if="{{detail.canAssign}}"><view class="field-label">分派工程师</view><picker range="{{engineers}}" range-key="name" value="{{editor.engineerIndex}}" bindchange="onEngineer" disabled="{{saving || confirming || pending || uploading || editor.conflict}}"><view class="picker mb">{{engineers[editor.engineerIndex].name}}</view></picker><block wx:if="{{detail.kind === 'external'}}"><view class="field"><view class="field-label">联系人</view><input class="input" value="{{editor.values.customer}}" data-field="customer" bindinput="onInput" maxlength="100" disabled="{{saving || confirming || pending || uploading || editor.conflict}}" /></view><view class="field"><view class="field-label">联系电话</view><input class="input" value="{{editor.values.phone}}" data-field="phone" bindinput="onInput" maxlength="11" type="number" disabled="{{saving || confirming || pending || uploading || editor.conflict}}" /></view></block></block>
  </block>
  <block wx:if="{{editor.kind === 'quote'}}"><view class="notice">新报价将使之前的确认失效，须对当前报价重新记录确认。</view><view class="field"><view class="field-label required">维修报价（元，0表示免费）</view><input class="input" type="digit" data-field="amount" value="{{editor.values.amount}}" bindinput="onInput" disabled="{{saving || confirming || pending || editor.conflict}}" /></view></block>
  <block wx:if="{{editor.kind === 'confirm'}}"><view class="notice">当前报价 ¥{{f.maskMoney(detail.quote,privacy)}}。{{detail.kind === 'inventory' ? '本店维修须由管理人员确认方案。' : '请先取得顾客对当前报价和方案的确认。'}}</view><view class="row mt"><text class="small">已核对并获得本次确认</text><switch checked="{{editor.values.accepted}}" data-field="accepted" bindchange="onInput" disabled="{{saving || confirming || pending || editor.conflict}}" /></view></block>
  <block wx:if="{{editor.kind === 'issue'}}"><view class="row gap-sm mb"><input class="input flex-1" value="{{editor.keyword}}" bindinput="onPartKeyword" bindconfirm="onSearchParts" placeholder="配件名称 / SKU" disabled="{{saving || confirming || pending || editor.conflict}}" /><button class="btn btn-line" bindtap="onSearchParts" loading="{{editor.searching}}">查找</button></view><view wx:for="{{editor.parts}}" wx:key="id" class="list-item" data-id="{{item.id}}" bindtap="onSelectPart"><view>{{item.name}}<view class="tiny muted">{{item.sku}} · 可用 {{item.quantity}}{{item.unit}}</view></view><text class="gold">{{editor.values.partId === item.id ? '已选择' : '选择'}}</text></view><button wx:if="{{editor.partMore}}" class="btn btn-line mt" bindtap="onMoreParts" loading="{{editor.searching}}">更多配件</button><view class="small mt">已选：{{editor.partName || '请选择配件'}}</view></block>
  <block wx:if="{{editor.kind === 'issue' || editor.kind === 'returnParts'}}"><view wx:if="{{editor.kind === 'returnParts'}}" class="notice">{{editor.partName}} · 原领用可退 {{editor.remaining}} 件，成本按原记录退回。</view><view class="field mt"><view class="field-label required">数量</view><input class="input" type="number" value="{{editor.values.quantity}}" data-field="quantity" bindinput="onInput" disabled="{{saving || confirming || pending || editor.conflict}}" /></view></block>
  <block wx:if="{{editor.kind === 'payment'}}"><view class="field"><view class="field-label required">{{paymentLabels[editor.paymentKind]}}金额（元）</view><input class="input" type="digit" value="{{editor.values.amount}}" data-field="amount" bindinput="onInput" disabled="{{saving || confirming || pending || uploading || editor.conflict}}" /></view><picker range="{{editor.methods}}" value="{{editor.methodIndex}}" bindchange="onMethod" disabled="{{saving || confirming || pending || uploading || editor.conflict}}"><view class="picker">{{editor.methods[editor.methodIndex]}}</view></picker><view class="row mt"><text class="small">确认本次{{paymentLabels[editor.paymentKind]}}已实际办理</text><switch checked="{{editor.values.accepted}}" data-field="accepted" bindchange="onInput" disabled="{{saving || confirming || pending || uploading || editor.conflict}}" /></view></block>
  <block wx:if="{{editor.kind === 'transition'}}"><view wx:if="{{editor.to === 'cancelled'}}" class="notice">取消前请退清对客收款；本店设备取消送修仍进入待复检。</view><view wx:if="{{editor.to === 'pending_pickup'}}" class="field"><view class="field-label required">维修结果与复测结论</view><textarea class="textarea" value="{{editor.values.result}}" data-field="result" bindinput="onInput" maxlength="2000" disabled="{{saving || confirming || pending || editor.conflict}}" /></view><block wx:if="{{editor.to === 'completed'}}"><view class="notice">请实际交接后登记。{{detail.kind === 'inventory' ? '本店设备会进入待复检，共享不会自动打开。' : '须结清维修报价并保留取机凭证。'}}</view><view class="field"><view class="field-label required">取机 / 交接人</view><input class="input" value="{{editor.values.pickupName}}" data-field="pickupName" bindinput="onInput" maxlength="100" disabled="{{saving || confirming || pending || uploading || editor.conflict}}" /></view><view class="field"><view class="field-label required">维修质保天数（0表示无）</view><input class="input" type="number" value="{{editor.values.warrantyDays}}" data-field="warrantyDays" bindinput="onInput" disabled="{{saving || confirming || pending || uploading || editor.conflict}}" /></view></block></block>
  <view wx:if="{{editor.kind === 'update' || editor.kind === 'payment' || (editor.kind === 'transition' && editor.to === 'completed')}}" class="mt"><view class="field-label">{{editor.kind === 'update' ? '追加外观照片（内部）' : editor.kind === 'payment' ? '本次收支凭证（内部）' : '取机/交接凭证（必填）'}}</view><view class="chips"><view wx:for="{{editor.photos}}" wx:key="fileId"><image class="repair-photo" src="{{item.url}}" mode="aspectFill" /><text class="tiny gold" data-index="{{index}}" bindtap="onRemovePhoto">移除</text></view></view><button class="btn btn-line mt" bindtap="onPhotos" disabled="{{saving || confirming || pending || uploading || editor.conflict}}" loading="{{uploading}}">添加内部凭证</button></view>
  <button wx:if="{{!pending}}" class="btn btn-primary mt" bindtap="onSubmitEditor" loading="{{saving || confirming}}" disabled="{{saving || confirming || uploading || editor.conflict}}">填写说明并提交</button>
 </view>
 <view wx:if="{{pending}}" class="notice">处理结果尚未确认，已锁定原内容。原样重试可避免重复领料或收退款。<button class="btn btn-primary mt" bindtap="onRetry" loading="{{saving}}" disabled="{{saving || uploading || confirming}}">原样重试</button></view>
 <block wx:if="{{detail}}">
  <section-card title="检测与维修"><view class="small">{{detail.diagnosis || '未填写检测结果'}}</view><view class="tiny muted mt-sm">预计完成 {{detail.expectedAt || '未填写'}} · {{detail.waitingParts ? '等待配件' : '未标记待配件'}}</view><view wx:if="{{detail.pickupName}}" class="small mt">取机 / 交接：{{detail.pickupName}} · 维修质保 {{detail.warrantyDays}} 天</view></section-card>
  <section-card title="配件领退"><view wx:for="{{detail.parts}}" wx:key="id" class="list-item"><view>{{item.name}} × {{item.quantity}}<view class="tiny muted">已退 {{item.returned}} · {{item.cost !== undefined ? '原领用成本 ¥'+f.maskMoney(item.cost,privacy) : '无权限查看成本'}}</view></view><button wx:if="{{canReturn && item.quantity > item.returned}}" class="btn btn-line btn-sm" data-id="{{item.id}}" bindtap="onReturn" disabled="{{editor || saving || pending || uploading}}">退料</button></view><view class="chips mt"><button wx:if="{{canIssue}}" class="btn btn-primary btn-sm" bindtap="onIssue" disabled="{{editor || saving || pending || uploading}}">领用配件</button><button class="btn btn-line btn-sm" bindtap="onParts" disabled="{{editor || saving || pending || uploading}}">配件库存与流水</button></view></section-card>
  <section-card title="收支记录"><view class="grid-2"><metric-item label="净配件成本" value="{{detail.partsCost !== undefined ? '¥'+f.maskMoney(detail.partsCost,privacy) : '无权限查看'}}" /><metric-item label="净维修费用" value="{{detail.expenses !== undefined ? '¥'+f.maskMoney(detail.expenses,privacy) : '无权限查看'}}" /></view><view wx:for="{{detail.payments}}" wx:key="id" class="list-item"><view>{{paymentLabels[item.kind]}} · {{item.method}}<view class="tiny muted">{{item.timeLabel}} · {{item.reason}}</view></view><text>¥{{f.maskMoney(item.amount,privacy)}}</text></view><view class="chips mt"><button wx:for="{{paymentKinds}}" wx:key="value" class="btn btn-line btn-sm" data-kind="{{item.value}}" bindtap="onPayment" disabled="{{editor || saving || pending || uploading}}">{{item.label}}</button></view><view wx:if="{{detail.costAllocation}}" class="tiny muted mt">本店维修成本已{{detail.costAllocation.policy === 'capitalize' ? '并入库存' : '单独归档'}}，本单不重复调整。</view></section-card>
  <section-card title="内部照片与凭证"><view class="chips"><view wx:for="{{detail.files}}" wx:key="fileId"><image class="repair-photo" src="{{item.url}}" data-id="{{item.fileId}}" bindtap="onPreview" mode="aspectFill" /><view class="tiny muted">{{item.purpose === 'appearance' ? '外观' : item.purpose === 'pickup' ? '取机/交接' : item.purpose === 'expense' ? '维修费用' : '对客收支'}}</view></view></view><view wx:if="{{!detail.files.length}}" class="small muted">无可访问的附件</view></section-card>
  <section-card title="处理时间线"><view wx:for="{{detail.timeline}}" wx:key="id" class="mb"><view>{{actionLabels[item.action] || item.action}} · {{f.label(statusMap,item.to)}}</view><view class="small muted mt-sm">{{item.note}}</view><view wx:if="{{item.data.result}}" class="small mt-sm">{{item.data.result}}</view><view class="tiny muted mt-sm">{{item.operator}} · {{item.timeLabel}}</view></view></section-card>
 </block>
</view>
</theme-shell>
