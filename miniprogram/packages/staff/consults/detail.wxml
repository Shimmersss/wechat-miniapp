<view class="container">
 <view wx:if="{{error}}" class="notice">{{error}}<button wx:if="{{!pending}}" class="btn btn-line mt" bindtap="load">刷新记录</button></view>
 <block wx:if="{{detail}}"><view class="card"><view class="row"><text class="h2">{{detail.kind === 'appointment' ? '到店预约' : detail.kind === 'order' ? '代理下单' : '商品咨询'}}</text><status-pill text="{{labels[detail.status]}}" tone="gold" /></view><view class="mt">{{detail.unit ? detail.unit.name : '门店咨询'}} {{detail.unit.storage}} {{detail.unit.color}}</view><view wx:if="{{detail.unit}}" class="tiny muted mt-sm">{{detail.unit.imeiMasked}}</view><view wx:if="{{detail.unit.price !== undefined && detail.kind !== 'order'}}" class="row mt-sm"><text class="small muted">提交时意向价（不锁价）</text><price-tag value="{{detail.unit.price}}" /></view><block wx:if="{{detail.agentOrder}}"><view class="row mt-sm"><text class="small muted">代理分享价 · {{detail.agentOrder.status === 'locked' ? '已锁定' : detail.agentOrder.status === 'sold' ? '已成交' : '锁定已释放'}}</text><price-tag value="{{detail.agentOrder.sharePrice}}" /></view><view wx:if="{{detail.agentOrder.status === 'locked'}}" class="tiny muted mt-sm">锁定至 {{detail.agentOrder.lockText}}，到期未成交自动释放</view><view wx:if="{{detail.agentOrder.agentName}}" class="small muted mt-sm">代理：{{detail.agentOrder.agentName}}{{detail.agentOrder.markup !== undefined ? ' · 加价 ¥' + detail.agentOrder.markup + '（成交后记为代理收益）' : ''}}</view></block><view class="divider"></view><view>{{detail.content || '未填写额外需求'}}</view><view class="small mt">{{detail.name || '未留称呼'}} · {{detail.phone}}</view><view wx:if="{{detail.kind === 'appointment'}}" class="mt">{{detail.date}} · {{detail.timeSlot}}</view><view wx:if="{{internal}}" class="tiny muted mt">来源 {{sources[detail.source]}} · 分享人 {{detail.shareOwnerName || detail.shareOwnerId || '无'}}</view></view>
 <section-card title="跟进进度"><view wx:for="{{detail.timeline}}" wx:key="id" class="mb"><view>{{labels[item.status]}} · {{item.actor}}</view><view class="tiny muted mt-sm">{{item.timeLabel}}</view><view wx:if="{{item.note}}" class="small mt-sm">{{item.note}}</view></view></section-card>
 <block wx:if="{{!pending}}"><view wx:if="{{internal && actions.length}}" class="card"><picker range="{{actions}}" range-key="label" value="{{actionIndex}}" bindchange="onAction" disabled="{{saving}}"><view class="picker">{{actions[actionIndex].label}}</view></picker><button class="btn btn-primary mt" disabled="{{saving || loading}}" bindtap="onChange">填写内部说明并保存</button></view><button wx:if="{{!internal && detail.canCancel}}" class="btn btn-line mt" disabled="{{saving || loading}}" bindtap="onChange">取消本次意向</button><button wx:if="{{internal && detail.canStartSale}}" class="btn btn-primary mt" disabled="{{saving || loading}}" bindtap="onSale">按当前库存价格开单</button><button wx:if="{{internal && detail.salesOrderId}}" class="btn btn-line mt" bindtap="onOrder">查看关联销售单</button></block>
 </block>
 <view wx:if="{{pending}}" class="notice">处理结果尚未确认，请原样重试。<button class="btn btn-primary mt" disabled="{{saving}}" loading="{{saving}}" bindtap="onRetry">原样重试</button></view>
</view>
