<wxs module="f" src="../../../utils/filters.wxs" />
<view class="container has-staff-tabbar">
 <view class="chips mb"><view wx:for="{{ranges}}" wx:key="value" class="chip {{range === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onRangeTap">{{item.label}}</view></view>
 <view wx:if="{{canExport}}" class="card"><button class="btn btn-line btn-block" bindtap="onExport" disabled="{{exporting || exportPending}}" loading="{{exporting}}">填写原因并导出销售退款明细</button><view wx:if="{{exportPending}}" class="notice mt">导出结果未知，保留原内容重试。<button class="btn btn-primary btn-block mt" bindtap="onRetryExport" disabled="{{exporting}}">原样重试</button></view><view wx:if="{{exportReport}}" class="mt"><view class="small">已生成 {{exportReport.rows}} 行 · {{exportReport.range === 'day' ? '今日' : exportReport.range === 'week' ? '本周' : '本月'}}明细</view><view class="tiny muted mt-sm">CSV可用Excel打开。链接15分钟内有效，文件含经营数据，请核对接收人。下载时按当前权限裁剪。</view><button class="btn btn-soft btn-block mt" bindtap="onDownloadExport" disabled="{{exporting}}" loading="{{exporting}}">保存并分享CSV文件</button></view></view>
 <view wx:if="{{error}}" class="notice">{{error}}<button class="btn btn-line btn-sm" bindtap="load">重试</button></view><view wx:if="{{loading}}" class="muted small mb">加载中…</view>
 <section-card wx:if="{{overview}}" title="销售与退款" dark="{{true}}">
  <view class="grid-3"><metric-item dark="{{true}}" label="销售台次" value="{{overview.qty}}" /><metric-item dark="{{true}}" label="销售净额" value="¥{{f.maskMoney(overview.amount,privacy)}}" /><metric-item dark="{{true}}" label="退款金额" value="¥{{f.maskMoney(overview.refundAmount,privacy)}}" /><metric-item dark="{{true}}" label="净毛利" value="{{overview.profit !== undefined ? '¥'+f.maskMoney(overview.profit,privacy) : '无权限查看'}}" /><metric-item dark="{{true}}" label="毛利率" value="{{overview.margin !== undefined ? f.percent(overview.margin,privacy) : '无权限查看'}}" /><metric-item dark="{{true}}" label="动销率" value="{{f.percent(overview.sellThrough,privacy)}}" /></view>
 </section-card>
 <view wx:if="{{overview}}" class="notice">{{overview.definition}} 退货台次 {{overview.returnedQty}}，期初可售 {{overview.openingStock}} 台。分母为0时动销率显示 --。</view>
 <section-card wx:if="{{visits}}" title="访问"><view class="grid-3"><metric-item label="访客UV" value="{{visits.uv}}" /><metric-item label="浏览PV" value="{{visits.pv}}" /><metric-item label="商品浏览" value="{{visits.productViews}}" /><metric-item label="分享浏览" value="{{visits.shareVisits}}" /><metric-item label="提交咨询人数" value="{{visits.consults}}" /><metric-item label="预约意向数" value="{{visits.appointments}}" /><metric-item label="咨询点击人数" value="{{visits.consultClicks}}" /><metric-item label="未核验来源UV" value="{{visits.bySource.unverified}}" /></view><view class="small muted mt">{{visits.definition}}</view><view class="small muted mt-sm">提交来源：自然 {{visits.consultBySource.natural}} · 顾客分享 {{visits.consultBySource.customer}} · 同行 {{visits.consultBySource.peer}} · 代理 {{visits.consultBySource.agent}}</view></section-card>
 <section-card wx:if="{{repair}}" title="维修经营"><view class="grid-3"><metric-item label="本期开单" value="{{repair.created}}"/><metric-item label="本期完工" value="{{repair.completed}}"/><metric-item label="开单队列完成率" value="{{f.percent(repair.completionRate,privacy)}}"/><metric-item label="平均完工时长" value="{{f.money(repair.avgHours)}}h"/><metric-item label="维修实收净额" value="¥{{f.maskMoney(repair.revenue,privacy)}}"/><metric-item label="对客净配件成本" value="{{repair.partsCost !== undefined ? '¥'+f.maskMoney(repair.partsCost,privacy) : '无权限查看'}}"/><metric-item label="对客净维修费用" value="{{repair.expenses !== undefined ? '¥'+f.maskMoney(repair.expenses,privacy) : '无权限查看'}}"/><metric-item label="维修毛利" value="{{repair.profit !== undefined ? '¥'+f.maskMoney(repair.profit,privacy) : '无权限查看'}}"/><metric-item label="本店维修归档成本" value="{{repair.internalRepairCost !== undefined ? '¥'+f.maskMoney(repair.internalRepairCost,privacy) : '无权限查看'}}"/></view><view class="tiny muted mt">{{repair.definition}}</view></section-card>
 <section-card title="每日趋势"><view class="chips mb"><view wx:for="{{trendMetrics}}" wx:key="value" wx:if="{{item.value !== 'profit' || overview.profit !== undefined}}" class="chip {{trendMetric === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onMetric">{{item.label}}</view></view>
  <view wx:for="{{chartRows}}" wx:key="day" class="trend-row"><view class="row small"><text>{{item.day}}</text><text>{{privacy && trendMetric !== 'uv' ? '••••' : f.money(item.chartValue)}}</text></view><view class="trend-track"><view class="trend-bar {{item.negative ? 'negative' : ''}}" style="width:{{privacy && trendMetric !== 'uv' ? 0 : item.width}}%;"></view></view></view>
 </section-card>
 <section-card title="维度拆分"><view class="chips mb"><view wx:for="{{dimensions}}" wx:key="value" class="chip {{dimension === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onDimension">{{item.label}}</view></view><view wx:for="{{breakdown}}" wx:key="key" class="list-item"><view><view class="h3">{{item.label}}</view><view class="tiny muted">销售 {{item.qty}} · 退货 {{item.returnedQty}}</view></view><view class="small">净额 ¥{{f.maskMoney(item.amount,privacy)}}<view class="tiny muted">毛利 {{item.profit !== undefined ? '¥'+f.maskMoney(item.profit,privacy) : '无权限查看'}}</view></view></view><empty-state wx:if="{{!breakdown.length && !loading}}" text="本期暂无成交/退款" /></section-card>
 <section-card wx:if="{{canInventory}}" title="当前库龄预警" subtitle="超过30天 {{ageingTotal}} 台"><view wx:for="{{ageing}}" wx:key="id" class="list-item" data-id="{{item.id}}" bindtap="onUnit"><view><view class="small">{{item.name}} {{item.storage}}</view><view class="tiny muted">{{item.imeiMasked}}</view></view><text class="price">{{item.ageDays}} 天 ›</text></view><button wx:if="{{ageingMore}}" class="btn btn-line btn-block mt" bindtap="onMoreAgeing">加载更多</button></section-card>
 <todo-block items="{{['代理收益对账']}}" />
</view><staff-tabbar active="stats" />
