.segmented { display: flex; background: var(--c-line); border-radius: var(--radius); padding: 6rpx; }
.seg { flex: 1; text-align: center; padding: 16rpx 0; border-radius: var(--radius-sm); font-size: 26rpx; color: var(--c-muted); }
.seg.active { background: var(--c-surface); color: var(--c-ink); font-weight: 700; }
.preview { padding: 0; overflow: hidden; }
.preview-img { width: 100%; height: 480rpx; display: block; background: var(--c-surface-soft); }
.preview-body { padding: 28rpx; }
