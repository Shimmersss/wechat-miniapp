<theme-shell>
<view class="container">
  <view class="notice">分享价 = 代理底价 + 你的加价。加价为固定金额，不能超过上限；已发出的分享按当时价格，改价后请重新转发。</view>
  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view wx:for="{{units}}" wx:key="id" class="card {{focusId === item.id ? 'focus' : ''}}">
    <view class="row">
      <view class="flex-1"><view class="h3 ellipsis">{{item.name}} {{item.storage}}</view><view class="tiny muted">{{item.color}} · {{item.grade}} · 门店零售 ¥{{item.retail}}</view></view>
      <view class="share"><view class="tiny muted">分享价</view><price-tag value="{{item.sharePrice}}" size="md" /></view>
    </view>
    <view class="row gap-sm mt">
      <text class="small muted">加价 ¥</text>
      <input class="input flex-1" type="digit" value="{{drafts[item.id]}}" data-id="{{item.id}}" bindinput="onDraft" disabled="{{savingId}}" />
      <button class="btn btn-primary btn-sm" data-id="{{item.id}}" data-index="{{index}}" bindtap="onSave" loading="{{savingId === item.id}}" disabled="{{savingId}}">保存</button>
    </view>
    <view class="tiny muted mt-sm">上限 ¥{{item.markupMax}}<text wx:if="{{item.aboveRetail}}" class="price"> · 当前分享价高于门店零售价</text></view>
  </view>
  <empty-state wx:if="{{!loading && !units.length}}" text="门店暂未开放可转发的设备" />
</view>
</theme-shell>
