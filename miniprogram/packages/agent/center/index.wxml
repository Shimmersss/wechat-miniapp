<wxs module="f" src="../../../utils/filters.wxs" />
<view class="container">
  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <view wx:if="{{overview}}" class="card dark">
    <view class="label">待转账收益</view>
    <view class="amount">¥{{f.money(overview.pendingAmount)}}</view>
    <view class="grid-2 mt">
      <view><view class="label">已转账累计</view><view class="sub">¥{{f.money(overview.settledAmount)}}</view></view>
      <view><view class="label">加价上限</view><view class="sub">¥{{f.money(overview.markupMax)}} / 台</view></view>
    </view>
  </view>
  <view wx:if="{{overview}}" class="card">
    <view class="grid-4">
      <metric-item align="center" label="今日访客" value="{{overview.todayVisitors}}" />
      <metric-item align="center" label="今日分享" value="{{overview.todayShares}}" />
      <metric-item align="center" label="锁定中" value="{{overview.lockedOrders}}" />
      <metric-item align="center" label="已成交" value="{{overview.soldOrders}}" />
    </view>
  </view>

  <view class="entries mb">
    <view class="entry" bindtap="onNavigate" data-url="/packages/agent/orders/index"><view class="entry-icon"><image src="/assets/icons/list.svg" /></view><text>我的订单</text></view>
    <view class="entry" bindtap="onNavigate" data-url="/packages/agent/commission/index"><view class="entry-icon"><image src="/assets/icons/chart.svg" /></view><text>收益明细</text></view>
    <view class="entry" bindtap="onNavigate" data-url="/packages/agent/markup/index"><view class="entry-icon"><image src="/assets/icons/layers.svg" /></view><text>加价管理</text></view>
    <view class="entry" bindtap="onNavigate" data-url="/packages/agent/invite/index"><view class="entry-icon"><image src="/assets/icons/users.svg" /></view><text>邀请代理</text></view>
  </view>

  <section-card title="可转发库存" subtitle="门店开放代理转发的在库设备">
    <view wx:for="{{units}}" wx:key="id" class="unit">
      <image class="thumb" src="{{item.cover}}" mode="aspectFill" />
      <view class="flex-1">
        <view class="h3 ellipsis">{{item.name}} {{item.storage}}</view>
        <view class="tiny muted ellipsis">{{item.color}} · {{item.grade}}</view>
        <view class="row mt-sm"><price-tag value="{{item.sharePrice}}" size="sm" /><text class="tiny muted" data-id="{{item.id}}" bindtap="onMarkup">加价 ¥{{item.markup}} ›</text></view>
        <view wx:if="{{item.aboveRetail}}" class="tiny price">高于门店零售价 ¥{{item.retail}}</view>
      </view>
      <button class="btn btn-primary btn-sm" data-id="{{item.id}}" bindtap="onShare">转发</button>
    </view>
    <empty-state wx:if="{{!loading && !units.length}}" text="门店暂未开放可转发的设备" />
  </section-card>
  <view class="notice">顾客只看到你的分享价；不能修改总部库存、成本与底价。成交一单记一笔收益，公司线下转账。</view>
</view>
