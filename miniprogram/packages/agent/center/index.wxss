.dark { background: var(--c-glass); color: var(--c-on-hero, var(--c-ink));
  backdrop-filter: blur(22px) saturate(180%); -webkit-backdrop-filter: blur(22px) saturate(180%);
  box-shadow: var(--e3), inset 0 0 0 1rpx var(--c-glass-edge); }
.label { font-size: 24rpx; color: var(--c-muted); }
.amount { font-size: 72rpx; font-weight: 600; letter-spacing: -2rpx; margin-top: 4rpx; font-variant-numeric: tabular-nums; }
.sub { font-size: 32rpx; font-weight: 600; margin-top: 4rpx; font-variant-numeric: tabular-nums; }
.entries { display: flex; background: var(--c-surface); border-radius: var(--radius-lg); padding: 28rpx 4rpx; }
.entry { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 12rpx; font-size: 24rpx; color: var(--c-ink); }
.entry-icon { width: 88rpx; height: 88rpx; border-radius: 28rpx; background: var(--c-surface-soft); display: flex; align-items: center; justify-content: center; }
.entry-icon image { width: 46rpx; height: 46rpx; }
.unit { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--c-line); }
.unit:last-child { border-bottom: 0; }
.thumb { width: 128rpx; height: 128rpx; border-radius: var(--radius-sm); background: var(--c-surface-soft); flex-shrink: 0; }
