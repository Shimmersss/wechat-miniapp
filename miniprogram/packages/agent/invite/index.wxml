<wxs module="f" src="../../../utils/filters.wxs" />
<theme-shell>
<view class="container">
  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <section-card dark="{{true}}">
    <view class="tiny invite-label">我的邀请码</view>
    <view class="code">{{inviteCode}}</view>
    <view class="row-start gap-sm mt">
      <button class="btn btn-soft btn-sm" bindtap="onCopy">复制邀请码</button>
      <button class="btn btn-sm invite-share" open-type="share">邀请好友</button>
    </view>
  </section-card>
  <section-card title="直属代理" subtitle="{{members.length}} 人">
    <view wx:for="{{members}}" wx:key="appliedAt" class="list-item"><text>{{item.name}}</text><view class="row-start gap-sm"><text class="tiny muted">{{item.appliedText}}</text><status-pill text="{{f.label(statusMap, item.status)}}" tone="{{f.tone(statusMap, item.status)}}" /></view></view>
    <empty-state wx:if="{{!members.length}}" text="还没有邀请到代理" />
  </section-card>
</view>
</theme-shell>
