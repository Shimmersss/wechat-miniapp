.notice.error { background: var(--c-red-soft); color: var(--c-red); }
.center { text-align: center; padding: 56rpx 32rpx; }
.rule { color: var(--c-ink-2); line-height: 1.8; }
.agree { display: flex; align-items: center; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--c-line); }
.check { width: 40rpx; height: 40rpx; border-radius: 50%; border: 2rpx solid var(--c-ink-4); margin-right: 16rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; }
.check.on { background: var(--c-ink); border-color: var(--c-ink); }
