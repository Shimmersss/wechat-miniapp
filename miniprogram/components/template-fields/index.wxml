<view wx:for="{{fields}}" wx:key="key" class="parameter">
  <view class="label {{item.required ? 'required' : ''}}">{{item.label}}</view>
  <view class="control">
    <view wx:if="{{item.type === 'select'}}"><scroll-view scroll-x="{{item.key !== 'grade'}}" class="options-scroll"><view class="options {{item.key === 'grade' ? 'grade-options' : ''}}"><view aria-role="button" wx:for="{{item.options}}" wx:for-item="option" wx:key="*this" class="option {{!custom[item.key] && values[item.key] === option ? 'selected' : ''}}" data-key="{{item.key}}" data-value="{{option}}" bindtap="change" aria-disabled="{{disabled}}">{{option}}</view><view wx:if="{{item.allowCustom}}" class="option {{custom[item.key] ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="chooseCustom">{{customLabels[item.key] || '自定义'}}</view></view></scroll-view><input wx:if="{{item.allowCustom && custom[item.key]}}" class="value-input" value="{{values[item.key]}}" maxlength="10" placeholder="自定义（1～10字）" data-key="{{item.key}}" bindinput="customInput" bindblur="customBlur" disabled="{{disabled}}" /></view>
    <switch wx:elif="{{item.type === 'boolean'}}" checked="{{values[item.key]}}" data-key="{{item.key}}" bindchange="change" disabled="{{disabled}}" />
    <view wx:elif="{{item.type === 'image'}}"><view class="photos"><view wx:for="{{values[item.key]}}" wx:for-item="photo" wx:key="fileId" class="photo"><image src="{{photo.url}}" mode="aspectFill" /><button data-key="{{item.key}}" data-index="{{index}}" bindtap="removeImage" disabled="{{disabled}}">删除</button></view></view><button wx:if="{{!values[item.key] || values[item.key].length < 9}}" class="upload" data-key="{{item.key}}" bindtap="chooseImage" disabled="{{disabled || uploading}}" loading="{{uploading}}">上传图片</button></view>
    <view wx:elif="{{item.type === 'date'}}" class="date-row"><picker mode="date" value="{{values[item.key]}}" data-key="{{item.key}}" bindchange="change" disabled="{{disabled}}" class="flex-picker"><view class="value-input {{values[item.key] ? '' : 'placeholder'}}">{{values[item.key] || (item.required ? '请选择日期' : '选填')}}</view></picker><text wx:if="{{!item.required && values[item.key] && !disabled}}" class="clear" data-key="{{item.key}}" data-value="" bindtap="change">清除</text></view>
    <input wx:else class="value-input" type="{{item.type === 'number' ? 'digit' : 'text'}}" value="{{values[item.key]}}" placeholder="{{item.required ? '请填写' : '选填'}}" data-key="{{item.key}}" bindinput="change" disabled="{{disabled}}" />
  </view>
</view>
