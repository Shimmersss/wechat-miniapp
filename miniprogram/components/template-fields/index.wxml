<view wx:for="{{fields}}" wx:key="key" class="parameter">
  <view class="label {{item.required ? 'required' : ''}}">{{item.label}}</view>
  <view class="control">
    <scroll-view wx:if="{{item.type === 'select'}}" scroll-x class="options-scroll"><view class="options"><view aria-role="button" wx:for="{{item.options}}" wx:for-item="option" wx:key="*this" class="option {{values[item.key] === option ? 'selected' : ''}}" data-key="{{item.key}}" data-value="{{option}}" bindtap="change" aria-disabled="{{disabled}}">{{option}}</view></view></scroll-view>
    <switch wx:elif="{{item.type === 'boolean'}}" checked="{{values[item.key]}}" data-key="{{item.key}}" bindchange="change" disabled="{{disabled}}" />
    <view wx:elif="{{item.type === 'image'}}"><view class="photos"><view wx:for="{{values[item.key]}}" wx:for-item="photo" wx:key="fileId" class="photo"><image src="{{photo.url}}" mode="aspectFill" /><button data-key="{{item.key}}" data-index="{{index}}" bindtap="removeImage" disabled="{{disabled}}">删除</button></view></view><button wx:if="{{!values[item.key] || values[item.key].length < 9}}" class="upload" data-key="{{item.key}}" bindtap="chooseImage" disabled="{{disabled || uploading}}" loading="{{uploading}}">上传图片</button></view>
    <input wx:else class="value-input" type="{{item.type === 'number' ? 'digit' : 'text'}}" value="{{values[item.key]}}" placeholder="{{item.required ? '请填写' : '选填'}}" data-key="{{item.key}}" bindinput="change" disabled="{{disabled}}" />
  </view>
</view>
