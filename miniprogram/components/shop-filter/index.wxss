/* 组件样式隔离：这里不用 app.wxss 的类，颜色走主题变量（CSS 变量可穿透组件） */
.bar { position: relative; z-index: 3; background: var(--c-bg); padding: 12rpx 0 16rpx; }
.sorts { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 12rpx 20rpx; }
.sort { display: flex; align-items: center; justify-content: center; gap: 6rpx; flex: 1; min-width: 0; font-size: 28rpx; color: var(--c-muted); }
.sort.on { color: var(--c-ink); font-weight: 700; }
.sort-text { max-width: 170rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.count {
  min-width: 30rpx; height: 30rpx; padding: 0 6rpx; box-sizing: border-box; border-radius: 15rpx;
  background: var(--c-selected); color: var(--c-on-selected);
  font-size: 20rpx; line-height: 30rpx; text-align: center;
}
.arrows { display: flex; flex-direction: column; gap: 4rpx; }
.up, .down { width: 0; height: 0; border-left: 8rpx solid transparent; border-right: 8rpx solid transparent; }
.up { border-bottom: 9rpx solid var(--c-ink-4); }
.down { border-top: 9rpx solid var(--c-ink-4); }
.up.lit { border-bottom-color: var(--c-ink); }
.down.lit { border-top-color: var(--c-ink); }
.chips { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.chip {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  height: 60rpx; border-radius: 30rpx; background: var(--c-surface);
  font-size: 26rpx; color: var(--c-ink-2); box-shadow: var(--e1);
}
.chip.on { background: var(--c-selected); color: var(--c-on-selected); font-weight: 600; }
.caret {
  width: 0; height: 0; border-left: 7rpx solid transparent; border-right: 7rpx solid transparent;
  border-top: 9rpx solid currentColor; transition: transform 0.15s ease;
}
.caret.flip { transform: rotate(180deg); }
.caret.point { transform: rotate(-90deg); color: var(--c-muted); }

.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 1; background: rgba(0, 0, 0, 0.45); }
.mask.full { z-index: 10; }
.mask.full.top { z-index: 20; }

.panel {
  position: absolute; left: calc(var(--gutter) * -1); right: calc(var(--gutter) * -1); top: 100%; z-index: 2;
  padding: 16rpx var(--gutter) 24rpx; background: var(--c-surface);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
}
.options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.option {
  display: flex; align-items: center; justify-content: center;
  height: 76rpx; border-radius: var(--radius-sm); background: var(--c-surface-soft);
  font-size: 26rpx; color: var(--c-ink); white-space: nowrap;
}
.option.on { background: var(--c-selected); color: var(--c-on-selected); font-weight: 600; }
.price-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.price-input {
  flex: 1; min-width: 0; height: 76rpx; padding: 0 20rpx; box-sizing: border-box;
  border-radius: var(--radius-sm); background: var(--c-surface-soft); color: var(--c-ink);
  font-size: 26rpx; text-align: center;
}
.ph { color: var(--c-muted); }
.dash { flex: none; width: 28rpx; height: 3rpx; background: var(--c-ink-4); }
.actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.actions.fixed { margin-top: 0; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--c-surface); border-top: 1rpx solid var(--c-line); }
.action { display: flex; align-items: center; justify-content: center; height: 88rpx; border-radius: 44rpx; font-size: 30rpx; font-weight: 700; }
.action.ghost { flex: 1; background: var(--c-surface-soft); color: var(--c-ink); }
.action.primary { flex: 2; background: var(--c-action); color: var(--c-action-ink); }

.drawer {
  position: fixed; top: 0; right: 0; bottom: 0; z-index: 11; width: 86%;
  display: flex; flex-direction: column; background: var(--c-surface);
}
.drawer-body { flex: 1; min-height: 0; padding: 28rpx; box-sizing: border-box; }
.group-title { margin: 32rpx 0 18rpx; font-size: 30rpx; font-weight: 700; color: var(--c-ink); }
.line { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.line .group-title { margin: 0; flex: none; }
.line-value { display: flex; align-items: center; gap: 10rpx; min-width: 0; font-size: 26rpx; color: var(--c-ink-2); }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 21; height: 76vh;
  display: flex; flex-direction: column; background: var(--c-surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}
.sheet-head { position: relative; padding: 32rpx 0 24rpx; text-align: center; }
.sheet-title { font-size: 32rpx; font-weight: 700; color: var(--c-ink); }
.sheet-close { position: absolute; right: 28rpx; top: 30rpx; width: 44rpx; height: 44rpx; }
.sheet-close::before, .sheet-close::after {
  content: ""; position: absolute; left: 50%; top: 50%; width: 36rpx; height: 3rpx; background: var(--c-muted);
}
.sheet-close::before { transform: translate(-50%, -50%) rotate(45deg); }
.sheet-close::after { transform: translate(-50%, -50%) rotate(-45deg); }
.cat-scroll { flex: none; white-space: nowrap; }
.cats { display: inline-flex; gap: 16rpx; padding: 0 28rpx 20rpx; }
.cat { flex: none; padding: 14rpx 32rpx; border-radius: var(--radius-sm); background: var(--c-surface-soft); font-size: 26rpx; color: var(--c-ink-2); }
.cat.on { background: var(--c-selected); color: var(--c-on-selected); font-weight: 600; }
.sheet-body { flex: 1; min-height: 0; display: flex; }
.side { flex: none; width: 170rpx; height: 100%; background: var(--c-surface-soft); }
.side-item { padding: 30rpx 12rpx; text-align: center; font-size: 26rpx; color: var(--c-ink-2); }
.side-item.on { background: var(--c-surface); color: var(--c-ink); font-weight: 700; }
.models { flex: 1; min-width: 0; height: 100%; padding: 0 24rpx; box-sizing: border-box; }
.series { padding: 24rpx 0 16rpx; font-size: 26rpx; font-weight: 700; color: var(--c-ink); }
.model-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }
.model {
  display: flex; align-items: center; justify-content: center; min-height: 80rpx; padding: 8rpx 12rpx; box-sizing: border-box;
  border-radius: var(--radius-sm); background: var(--c-surface-soft);
  font-size: 24rpx; line-height: 1.3; color: var(--c-ink); text-align: center;
}
.model.on { background: var(--c-selected); color: var(--c-on-selected); font-weight: 600; }
.models-empty { padding: 60rpx 0; text-align: center; font-size: 26rpx; color: var(--c-muted); }
