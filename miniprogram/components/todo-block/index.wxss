/* 开发待办：临时组件，表达「这块还没做完」。
 * 用虚线的凹槽，不抢真实内容的注意力。全部完成后应删除该组件。 */
.todo {
  border: 2rpx dashed var(--c-ink-4);
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
  margin-bottom: var(--gap);
  background: var(--c-well);
}
.head { font-size: 24rpx; font-weight: 700; color: var(--c-ink-2); margin-bottom: 8rpx; }
.item { font-size: 22rpx; color: var(--c-ink-2); line-height: 1.8; }
