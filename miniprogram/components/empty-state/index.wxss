.empty { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; color: var(--c-muted); gap: 16rpx; }
.icon { font-size: 72rpx; color: #D2D2D7; }
.text { font-size: 28rpx; }
.btn { margin: 0; height: 64rpx; line-height: 64rpx; padding: 0 28rpx; font-size: 26rpx; border-radius: 999rpx; background: var(--c-surface-soft); color: var(--c-ink); }
.btn::after { border: 0; }
