.metric { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.metric.center { align-items: center; text-align: center; }
.label { font-size: 24rpx; color: var(--c-muted); }
.value { font-size: 40rpx; font-weight: 600; letter-spacing: -0.5rpx; color: var(--c-ink); font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.value.hl { color: var(--c-ink); }
.hint { font-size: 22rpx; color: var(--c-muted); }
.dark .label, .dark .hint { color: rgba(255,255,255,.6); }
.dark .value, .dark .value.hl { color: #fff; }
.value.na { font-size: 26rpx; font-weight: 400; letter-spacing: 0; line-height: 56rpx; color: var(--c-muted); }
.dark .value.na { color: rgba(255,255,255,.5); }
