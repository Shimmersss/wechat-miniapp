<view class="card" bindtap="onTap">
  <image wx:if="{{unit.cover}}" class="cover" src="{{unit.cover}}" mode="aspectFill" lazy-load />
  <view wx:else class="cover placeholder"><image class="placeholder-img" src="{{placeholder}}" mode="aspectFit" /><text class="placeholder-text">暂无实拍</text></view>
  <view class="body">
    <view class="name ellipsis">{{unit.name}}</view>
    <view class="spec">{{unit.storage}}<text wx:if="{{unit.ram}}"> · 运行内存 {{unit.ram}}</text>  {{unit.color}}</view>
    <view class="foot">
      <price-tag value="{{unit.price}}" size="md" />
      <text wx:if="{{unit.lotCount > 1}}" class="grade">余 {{unit.lotCount}} 件</text>
      <text wx:elif="{{unit.grade}}" class="grade">{{unit.grade}}</text>
    </view>
  </view>
</view>
