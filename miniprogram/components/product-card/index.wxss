.card { background: var(--c-surface); border-radius: var(--radius-lg); overflow: hidden; }
.cover { width: 100%; height: 320rpx; background: var(--c-surface-soft); display: block; }
.body { padding: 22rpx 24rpx 26rpx; }
.name { font-size: 30rpx; font-weight: 600; letter-spacing: -0.3rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.spec { font-size: 24rpx; color: var(--c-muted); margin-top: 6rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.foot { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.grade { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 999rpx; background: var(--c-surface-soft); color: var(--c-ink-2); }
