/* 品牌头：logo 墨色实心 + 更紧的字距 */
.brand { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 4rpx 28rpx; }
.left { display: flex; align-items: center; gap: 20rpx; }
.logo {
  width: 76rpx; height: 76rpx; border-radius: 24rpx;
  background: var(--c-ink); color: var(--c-on-ink);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 800;
  box-shadow: var(--e-ink);
}
.name { font-size: 40rpx; font-weight: 800; letter-spacing: -0.8rpx; color: var(--c-ink); }
.slogan { font-size: 24rpx; color: var(--c-muted); margin-top: 4rpx; }
.dark .name { color: var(--c-ink); }
.dark .slogan { color: var(--c-muted); }
.dark .logo { background: var(--c-ink); box-shadow: var(--e-ink); }
.right { display: flex; align-items: center; gap: 16rpx; }
