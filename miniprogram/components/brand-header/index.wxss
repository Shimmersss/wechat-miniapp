/* 品牌头：logo 墨色实心 + 更紧的字距。
 * 零售绿主题下整体变成深绿卡片 —— 由变量控制，不用后代选择器
 * （组件样式隔离，祖先类名进不来）。 */
.brand {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--brand-pad, 8rpx 4rpx 28rpx);
  background: var(--brand-bg, transparent);
  border-radius: var(--brand-radius, 0);
  margin-bottom: var(--brand-mb, 0);
  box-shadow: var(--brand-shadow, none);
}
.left { display: flex; align-items: center; gap: 20rpx; }
.logo {
  width: 76rpx; height: 76rpx; border-radius: 24rpx;
  background: var(--brand-logo-bg, var(--c-ink));
  color: var(--brand-logo-ink, var(--c-on-ink));
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 800;
  box-shadow: var(--brand-logo-shadow, var(--e-ink));
}
.name { font-size: 40rpx; font-weight: 800; letter-spacing: -0.8rpx; color: var(--brand-name, var(--c-ink)); }
.slogan { font-size: 24rpx; color: var(--brand-slogan, var(--c-muted)); margin-top: 4rpx; }
.dark .name { color: var(--brand-name, var(--c-ink)); }
.dark .slogan { color: var(--brand-slogan, var(--c-muted)); }
.dark .logo { background: var(--brand-logo-bg, var(--c-ink)); box-shadow: var(--brand-logo-shadow, var(--e-ink)); }
.right { display: flex; align-items: center; gap: 16rpx; }
