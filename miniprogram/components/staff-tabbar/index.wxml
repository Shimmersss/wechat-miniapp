<view class="tabbar">
  <view wx:for="{{tabs}}" wx:key="key" class="tab {{active === item.key ? 'active' : ''}}" data-key="{{item.key}}" data-url="{{item.url}}" bindtap="onTap">
    <image class="icon" src="/assets/icons/{{item.icon}}{{active === item.key ? '' : '-gray'}}.svg" />
    <text class="text">{{item.text}}</text>
  </view>
</view>
