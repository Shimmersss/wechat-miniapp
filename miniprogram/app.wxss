@import "./styles/theme.wxss";

/* ============================================================
 * 全局样式 · 方案 G「雾白层叠」
 *
 * 三条铁律：
 *   1. 分层靠物理感（虚化 / 投影 / 凹槽），不靠彩色块。
 *   2. 颜色只有两种有含义：墨色（主操作、选中）、红色（金额、预警）。
 *   3. 每页只有一个 .glass 主块，其余一律 .card 白卡。
 * ============================================================ */

/* page 是特殊根节点，拿不到 .theme-root 上的 CSS 变量，
 * 所以这里只能用中性值兜底；真实底色由 theme-shell 与
 * utils/theme.syncNativeChrome() 同步。 */
page {
  background: #F2F3F5;
  color: #111215;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, scroll-view { box-sizing: border-box; }

/* ---------- 布局 ---------- */
/* .container 是全站页面根容器，顺便挂上顶部环境光：
 * 毛玻璃需要「下面有东西可虚化」才看得出效果，纯白底上玻璃等于没做。
 * 光晕用 ::before 绝对定位在容器最底层，不占布局高度。 */
/* z-index: 0 建立层叠上下文，光晕用 -1 垫在所有内容之下。
 * 不要改回给子元素写 position: relative：那会让放在 .container 里的
 * .footer-bar 等 fixed 元素失效，也漏掉 picker 这类没列到的子元素。 */
.container {
  position: relative; z-index: 0;
  padding: var(--gutter); padding-bottom: calc(var(--gutter) + env(safe-area-inset-bottom));
}
.container::before {
  content: "";
  position: absolute; left: -80rpx; right: -80rpx; top: -80rpx; height: 900rpx;
  z-index: -1; pointer-events: none;
  background:
    radial-gradient(380rpx 320rpx at 14% 22%, var(--c-aura-1), transparent 70%),
    radial-gradient(420rpx 340rpx at 90% 16%, var(--c-aura-2), transparent 70%),
    radial-gradient(440rpx 380rpx at 52% 54%, var(--c-aura-3), transparent 74%);
  filter: blur(34px);
  -webkit-mask-image: linear-gradient(to bottom, var(--c-ink) 52%, transparent);
  mask-image: linear-gradient(to bottom, var(--c-ink) 52%, transparent);
}
/* staff-tabbar 组件自带 .ph 占位（184rpx + 安全区），这里只补一点呼吸，不能叠加两份 */
.container.has-staff-tabbar { padding-bottom: calc(var(--gutter) + env(safe-area-inset-bottom)); }

/* 顾客端 tabBar 页：原生 tabBar 是 fixed 的（自定义组件高 104rpx + 安全区）。
 * 容器默认底部内边距只有 --gutter(28rpx)，内容会紧贴甚至被压到 tabBar 下面，
 * 所以带 tabBar 的页统一用这个类避让。 */
.container.has-tabbar {
  padding-bottom: calc(104rpx + var(--gutter) + env(safe-area-inset-bottom));
}
.row { display: flex; align-items: center; justify-content: space-between; }
.row-start { display: flex; align-items: center; }
.col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-width: 0; }
.grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); }
.grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
.grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); }
.gap-sm { gap: 16rpx; }
.mt-sm { margin-top: 12rpx; } .mt { margin-top: var(--gap); } .mb { margin-bottom: var(--gap); }
/* 块级按钮与下一张卡片之间：--gap(24rpx) 视觉上偏挤，
   单独给按钮一个更大的下边距，避免「按钮贴着卡片」。 */
button.btn-block.mb { margin-bottom: 40rpx; }
button.btn.mb { margin-bottom: 40rpx; }
button.btn.mt { margin-top: var(--gap); }
button.btn.mt-sm { margin-top: 12rpx; }
/* 按钮后面紧跟卡片时用它，比 --gap 更松一档 */
.mb-strong { margin-bottom: 44rpx; }
.divider { height: 1rpx; background: var(--c-line); margin: 24rpx 0; }

/* ---------- 文本 ---------- */
.h1 { font-size: 48rpx; font-weight: 800; letter-spacing: -1rpx; line-height: 1.25; }
.h2 { font-size: 36rpx; font-weight: 800; letter-spacing: -0.5rpx; }
.h3 { font-size: 30rpx; font-weight: 700; }
.muted { color: var(--c-muted); }
.tiny { font-size: 24rpx; }
.small { font-size: 26rpx; }
.gold { color: var(--c-ink); font-weight: 700; }   /* 历史名：现为墨色强调 */
.price { color: var(--c-price); font-weight: 700; }
.num { font-variant-numeric: tabular-nums; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* ---------- L1 白卡 ---------- */
.card {
  background: var(--c-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--e1);
  margin-bottom: var(--gap);
}
.card-dark { background: var(--c-navy-2); color: #fff; }

/* ---------- L2 毛玻璃：每页只能有一个主块用 ---------- */
.glass {
  background: var(--c-glass);
  color: var(--c-on-hero, var(--c-ink));
  backdrop-filter: blur(22px) saturate(180%);
  -webkit-backdrop-filter: blur(22px) saturate(180%);
  box-shadow: var(--e3), inset 0 0 0 1rpx var(--c-glass-edge);
  border-radius: var(--radius-xl);
  padding: 32rpx;
  margin-bottom: var(--gap);
}

/* ---------- 卡内凹槽：图标底、数据格、标签 ---------- */
.well {
  background: var(--c-well);
  box-shadow: inset 0 2rpx 4rpx var(--c-hair);
  border-radius: var(--radius);
}

/* ---------- 提示条：白卡 + 左侧红线，不整块变红 ---------- */
/* 提示条：一律中性灰，不用红色。
 * 原来整条是红字 + 左侧红边，视觉上太吵——开发模式的说明、结果未知的
 * 重试提示这类内容也被染成告警色，反而让真正的错误失去辨识度。
 * 现在统一成浅灰底 + 次级文字，红边也去掉。 */
.notice {
  background: var(--c-surface-soft);
  color: var(--c-ink-2);
  border-radius: var(--radius);
  padding: 24rpx 30rpx;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: var(--gap);
  box-shadow: inset 0 0 0 1rpx var(--c-line);
}
.notice.info { color: var(--c-muted); }

/* ---------- 按钮 ---------- */
button.btn {
  margin: 0; padding: 0 36rpx; height: 88rpx; line-height: 88rpx;
  border-radius: var(--radius-pill); font-size: 30rpx; font-weight: 700;
  border: 0; width: auto; white-space: nowrap;
}
button.btn::after { border: 0; }
button.btn-primary { background: var(--c-action); color: var(--c-action-ink); box-shadow: var(--e-ink); }
button.btn-dark { background: var(--c-navy-2); color: #fff; }
button.btn-line { background: var(--c-surface); color: var(--c-ink); box-shadow: var(--e1); }
button.btn-soft { background: var(--c-well); color: var(--c-ink); }
button.btn-danger { background: var(--c-red); color: #fff; }
button.btn-block { display: block; width: 100%; }
button.btn-sm { height: 64rpx; line-height: 64rpx; padding: 0 26rpx; font-size: 26rpx; }
/* 禁用态：不要用 opacity 整体压暗——深色主题下按钮底色本来就暗，
   再叠 opacity 会和文字一起糊成一块「纯色方框」。
   改成显式的禁用配色：底色不动、文字降一档、去掉投影。 */
button.btn[disabled] {
  opacity: 1;
  background: var(--c-well);
  color: var(--c-muted);
  box-shadow: none;
}
button.btn-line[disabled],
button.btn-primary[disabled],
button.btn-soft[disabled],
button.btn-dark[disabled] {
  background: var(--c-well);
  color: var(--c-muted);
  box-shadow: none;
}

/* ---------- 筛选 chip ---------- */
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 14rpx 30rpx; border-radius: var(--radius-pill);
  background: var(--c-surface); color: var(--c-ink-2);
  font-size: 28rpx; font-weight: 600; box-shadow: var(--e1);
}
.chip.active { background: var(--c-selected); color: var(--c-on-selected); box-shadow: var(--e-ink); }

/* ---------- 表单 ---------- */
.field { margin-bottom: 28rpx; }
.field-label { font-size: 26rpx; color: var(--c-muted); margin-bottom: 12rpx; }
.field-label.required::after { content: " *"; color: var(--c-red); }
.input, .picker, .textarea {
  background: var(--c-well); border: 0; border-radius: var(--radius);
  padding: 20rpx 24rpx; font-size: 30rpx; min-height: 88rpx; width: 100%;
  box-shadow: inset 0 2rpx 4rpx var(--c-hair);
}
.textarea { height: 180rpx; }
.search-bar {
  display: flex; align-items: center; height: 84rpx; padding: 0 28rpx;
  background: var(--c-surface); border-radius: var(--radius-pill);
  color: var(--c-muted); font-size: 28rpx; box-shadow: var(--e1);
}
.search-bar .search-icon { width: 36rpx; height: 36rpx; margin-right: 14rpx; flex-shrink: 0; }

/* ---------- 列表 ---------- */
.list-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 0; border-bottom: 1rpx solid var(--c-line);
}
.list-item:last-child { border-bottom: 0; }

/* ---------- 底部固定操作区 ---------- */
/* 底部操作条：悬浮圆角胶囊，和 staff-tabbar 保持同一套语言。
 * 原来写的是 left:0/right:0/bottom:0 的通栏，背景铺满整条屏幕宽度，
 * 在页面里看就是「按钮下面一条直角色块」，非常突兀。 */
.footer-bar {
  position: fixed; left: var(--gutter); right: var(--gutter);
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 40rpx;
  background: var(--c-overlay, var(--c-glass-flat));
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  box-shadow: var(--e2), inset 0 0 0 1rpx var(--c-glass-edge);
  z-index: 10;
}
.footer-bar button.btn { flex: 1; padding: 0 16rpx; }
/* 与 .footer-bar 的实际高度对齐：16*2 + 88(按钮) + 20(底部) + 安全区 */
.footer-space { height: calc(144rpx + env(safe-area-inset-bottom)); }

/* ---------- 环境光：页面顶部柔光，给毛玻璃提供虚化素材 ----------
 * 挂在页面最外层容器上；不要放进 scroll-view，否则会跟着滚走。 */
.aura-host { position: relative; }
.aura-host::before {
  content: "";
  position: absolute; left: -80rpx; right: -80rpx; top: -120rpx; height: 1040rpx;
  z-index: 0; pointer-events: none;
  background:
    radial-gradient(420rpx 360rpx at 16% 26%, var(--c-aura-1), transparent 70%),
    radial-gradient(460rpx 380rpx at 88% 20%, var(--c-aura-2), transparent 70%),
    radial-gradient(500rpx 420rpx at 56% 60%, var(--c-aura-3), transparent 72%);
  filter: blur(34px);
  -webkit-mask-image: linear-gradient(to bottom, var(--c-ink) 55%, transparent);
  mask-image: linear-gradient(to bottom, var(--c-ink) 55%, transparent);
}

/* ---------- 分组：白卡内的一组图标入口 ---------- */
.group { padding: 4rpx 12rpx 8rpx; }
.group-head { display: flex; align-items: center; padding: 30rpx 16rpx 8rpx; }
.group-title { font-size: 30rpx; font-weight: 800; letter-spacing: -0.4rpx; }
.group-meta {
  margin-left: auto; font-size: 22rpx; color: var(--c-muted);
  background: var(--c-well); padding: 4rpx 18rpx; border-radius: 999rpx; font-weight: 600;
}
.tiles { display: flex; flex-wrap: wrap; }
.tile {
  width: 25%; padding: 16rpx 4rpx 24rpx;
  display: flex; flex-direction: column; align-items: center;
}
.tile .ico {
  width: 100rpx; height: 100rpx; border-radius: 32rpx; background: var(--c-well);
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 2rpx 4rpx var(--c-hair);
}
.tile .ico-img { width: 64rpx; height: 64rpx; }
.tile .tile-label {
  margin-top: 16rpx; font-size: 24rpx; color: var(--c-ink-2);
  font-weight: 600; text-align: center;
}
