/* 夏目数码设计令牌 · 方案 G「雾白层叠」 · 双主题
 *
 * ┌─ 为什么要迁到 .theme-root ────────────────────────────────┐
 * │ 小程序的 <page> 是特殊根节点，无法动态加 class，          │
 * │ 所以 page{} 上的 CSS 变量没法在运行时切换。               │
 * │ 现在变量挂在 .theme-root / .theme-dark 两个类上，          │
 * │ 由 theme-shell 组件包住每个页面的内容，切换主题 = 换类名。│
 * └──────────────────────────────────────────────────────────┘
 *
 * 分层模型（两套主题一致，只是明暗反转）：
 *   L0   页面底   --c-bg        浅：冷灰 / 深：近黑
 *   L0.5 环境光   --c-aura-*    顶部柔光，给毛玻璃提供可虚化的素材
 *   L1   白卡     --c-surface   浅：纯白 / 深：抬高的灰黑
 *   L2   毛玻璃   --c-glass     半透明层 + backdrop-filter，每页唯一主块
 *   卡内 凹槽     --c-well      比卡片低一级（浅）/ 高一级（深）
 */

/* ============ 浅色主题（默认） ============ */
.theme-root {
  /* 中性色 */
  --c-bg: #F2F3F5;
  --c-surface: #FFFFFF;
  --c-surface-soft: #F3F4F6;
  --c-well: #F3F4F6;
  --c-well-deep: #ECEDF0;

  /* 文字四级灰 */
  --c-ink: #111215;
  --c-ink-2: #4B4F57;
  --c-muted: #9599A1;
  --c-ink-4: #BFC2C8;
  --c-line: rgba(17, 18, 21, 0.07);

  /* 「墨色底上的文字」：浅色主题墨底是深色 → 用白字；
     深色主题墨底反过来是浅色 → 必须用深字，否则白底白字看不见。
     所有 background: var(--c-ink) 的地方，文字一律用 --c-on-ink。 */
  --c-on-ink: #FFFFFF;

  /* 主操作按钮：浅色用墨色实心（最重的视觉锚点）；
     深色不能沿用墨色，否则会变成一大块白，改成品牌蓝紫实心。 */
  --c-action: #111215;
  --c-action-ink: #FFFFFF;

  /* 品牌与语义色（两套主题只有明度调整，色相不变） */
  --c-gold: #111215;
  --c-gold-light: #C8CBD2;
  --c-gold-soft: #F3F4F6;
  --c-navy: #111215;
  --c-navy-2: #2A2D33;
  --c-price: #E5484D;
  --c-red: #E5484D;
  --c-red-soft: #FFF0EF;
  --c-green: #1F9D55;
  --c-green-soft: #EDF9F1;
  --c-orange: #B25000;
  --c-orange-soft: #FFF6EA;
  --c-blue: #2F6BEA;
  --c-blue-soft: #EEF3FF;

  /* 环境光 */
  --c-aura-1: #C9DBFF;
  --c-aura-2: #FFD6C2;
  --c-aura-3: #E3D6FF;
  --c-aura-alpha: 1;

  /* 圆角 */
  --radius-sm: 20rpx;
  --radius: 28rpx;
  --radius-lg: 44rpx;
  --radius-xl: 52rpx;
  --radius-pill: 999rpx;

  /* 三级投影：浅色靠「阴影」，深色靠「更黑的阴影」 */
  --e1: 0 2rpx 4rpx rgba(17, 18, 21, 0.04), 0 12rpx 36rpx rgba(17, 18, 21, 0.05);
  --e2: 0 2rpx 4rpx rgba(17, 18, 21, 0.05), 0 24rpx 64rpx rgba(17, 18, 21, 0.08);
  --e3: 0 4rpx 12rpx rgba(17, 18, 21, 0.06), 0 44rpx 96rpx rgba(17, 18, 21, 0.14);
  --e-ink: 0 12rpx 28rpx rgba(17, 18, 21, 0.24);
  --shadow: var(--e1);

  /* 毛玻璃 */
  --c-glass: linear-gradient(160deg,
      rgba(255, 255, 255, 0.82) 0%,
      rgba(255, 255, 255, 0.50) 55%,
      rgba(255, 255, 255, 0.62) 100%);
  --c-glass-flat: rgba(255, 255, 255, 0.66);
  --c-glass-edge: rgba(255, 255, 255, 0.85);
  --c-hair: rgba(17, 18, 21, 0.07);

  /* 主块（.glass）里的文字色：浅色主题主块是白玻璃 → 用墨色 */
  --c-on-hero: #111215;
  --c-on-hero-2: #4B4F57;

  /* 底栏文字：未选中要看得清（不能只靠 opacity 压暗） */
  --c-tab-idle: #6B7079;
  --c-tab-on: #111215;

  /* 底栏/浮层专用（深色下需要更高的不透明度才看得清） */
  --c-bar-bg: rgba(255, 255, 255, 0.72);
  --c-sheet-bg: #FFFFFF;
  --c-mask: rgba(17, 18, 21, 0.42);

  /* 间距 */
  --gap: 24rpx;
  --gutter: 28rpx;

  /* 演示分包沿用的别名 */
  --frost-ink: var(--c-ink);
  --frost-ink-2: var(--c-ink-2);
  --frost-ink-3: var(--c-muted);
  --frost-ink-4: var(--c-ink-4);
  --frost-bg: var(--c-bg);
  --frost-card: var(--c-surface);
  --frost-well: var(--c-well);
  --frost-red: var(--c-red);
  --frost-red-soft: var(--c-red-soft);
  --frost-green: var(--c-green);
  --frost-aura-1: var(--c-aura-1);
  --frost-aura-2: var(--c-aura-2);
  --frost-aura-3: var(--c-aura-3);
  --frost-skin-1: #F8DCC6;
  --frost-skin-2: #E8BE9E;
  --frost-glass: var(--c-glass);
  --frost-glass-flat: var(--c-glass-flat);
  --frost-glass-edge: var(--c-glass-edge);
  --frost-hair: var(--c-hair);
  --frost-e1: var(--e1);
  --frost-e2: var(--e2);
  --frost-e3: var(--e3);
  --frost-ink-shadow: var(--e-ink);

  /* 主题容器自身 */
  background: var(--c-bg);
  color: var(--c-ink);
  min-height: 100vh;
}

/* ============ 深色主题 ============
 * 关键：深色下「白卡」不能真的变白，否则刺眼。
 * 用比页面底更亮的灰黑来表达「抬高」，凹槽反而比卡片更亮一点点，
 * 靠投影 + 内高光边维持层次，和浅色版的物理直觉保持一致。 */
.theme-dark {
  --c-bg: #0B0C0F;
  --c-surface: #17191E;
  --c-surface-soft: #212429;
  --c-well: #212429;
  --c-well-deep: #282C33;

  --c-ink: #F5F6F8;
  --c-ink-2: #C2C6CE;
  --c-muted: #828792;
  --c-ink-4: #5B606A;
  --c-line: rgba(255, 255, 255, 0.08);

  --c-on-ink: #0B0C0F;

  /* 深色下主按钮改用品牌蓝紫：墨色在深底上会变成刺眼的白块 */
  --c-action: #6E7BFF;
  --c-action-ink: #0B0C0F;

  --c-gold: #F5F6F8;
  --c-gold-light: #6B7079;
  --c-gold-soft: #212429;
  --c-navy: #F5F6F8;
  --c-navy-2: #2E323A;
  /* 深色下红色要提亮，否则在近黑底上发闷、对比不足 */
  --c-price: #FF7A6E;
  --c-red: #FF7A6E;
  --c-red-soft: rgba(255, 122, 110, 0.14);
  --c-green: #4ADE80;
  --c-green-soft: rgba(74, 222, 128, 0.13);
  --c-orange: #FFB07A;
  --c-orange-soft: rgba(255, 176, 122, 0.14);
  --c-blue: #6BA6FF;
  --c-blue-soft: rgba(107, 166, 255, 0.14);

  /* 环境光：深色底上要更饱和才看得出来 */
  --c-aura-1: rgba(80, 130, 255, 0.42);
  --c-aura-2: rgba(255, 120, 80, 0.32);
  --c-aura-3: rgba(150, 110, 255, 0.36);

  /* 深色下投影要更重，否则层次浮不起来 */
  --e1: 0 2rpx 4rpx rgba(0, 0, 0, 0.34), 0 12rpx 36rpx rgba(0, 0, 0, 0.42);
  --e2: 0 2rpx 4rpx rgba(0, 0, 0, 0.4), 0 24rpx 64rpx rgba(0, 0, 0, 0.5);
  --e3: 0 4rpx 14rpx rgba(0, 0, 0, 0.5), 0 44rpx 96rpx rgba(0, 0, 0, 0.66);
  --e-ink: 0 12rpx 28rpx rgba(0, 0, 0, 0.6);

  /* 毛玻璃：用亮灰玻璃而不是白玻璃，并抬高内高光边 */
  --c-glass: linear-gradient(160deg,
      rgba(62, 68, 80, 0.78) 0%,
      rgba(34, 37, 44, 0.72) 55%,
      rgba(46, 50, 58, 0.75) 100%);
  --c-glass-flat: rgba(30, 33, 39, 0.82);
  --c-glass-edge: rgba(255, 255, 255, 0.14);
  --c-hair: rgba(255, 255, 255, 0.07);

  /* 深色主块是暗玻璃 → 文字反白 */
  --c-on-hero: #F5F6F8;
  --c-on-hero-2: #C2C6CE;

  --c-tab-idle: #9AA0AB;
  --c-tab-on: #F5F6F8;

  --c-bar-bg: rgba(20, 22, 27, 0.82);
  --c-sheet-bg: #17191E;
  --c-mask: rgba(0, 0, 0, 0.62);

  background: var(--c-bg);
  color: var(--c-ink);
}

/* 老安卓 / 低版本微信不支持 backdrop-filter：
 * 浅色退化成高不透明白卡；深色同理退化成高不透明灰黑卡。
 * 层次仍靠投影 + 内高光边成立，只是少了「虚化」这一档。 */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .theme-root {
    --c-glass: linear-gradient(160deg,
        rgba(255, 255, 255, 0.97) 0%,
        rgba(255, 255, 255, 0.93) 55%,
        rgba(255, 255, 255, 0.95) 100%);
    --c-glass-flat: rgba(255, 255, 255, 0.95);
  }
  .theme-dark {
    --c-glass: linear-gradient(160deg,
        rgba(40, 44, 52, 0.98) 0%,
        rgba(30, 33, 39, 0.97) 55%,
        rgba(36, 39, 46, 0.98) 100%);
    --c-glass-flat: rgba(30, 33, 39, 0.97);
  }
}

/* page 元素兜底：page 的底色跟随主题，避免下拉回弹时露出白边。
 * 这里不能引用变量（page 上没有），由 app.js 用 wx.setBackgroundColor 同步。 */
page {
  background: #F2F3F5;
}

/* ============ 主题：零售绿（retail） ============
 * 在「雾白层叠」的分层体系内，把方案 A 的视觉特征搬回来：
 *   - 墨色 → 深绿 #1C2B20：品牌区、主按钮、选中态
 *   - 图标底从「凹槽」改成「白卡 + 投影」：这是方案 A 的标志性做法，
 *     彩色图标衬白底方卡，比凹槽更亮、更跳，和深绿形成对比
 *   - 页面底更白一点（#F7F8F7），让白卡靠投影而不是靠底色差区分
 * 层次逻辑不变：底 → 白卡 → 毛玻璃主块，只是色相换成绿。
 * 主块（.glass / dark 属性）在本主题里渲染成深绿实心，而不是半透明玻璃——
 * 这是方案 A 的做法，也是它比雾白版更「实」的原因。 */
.theme-retail {
  --c-bg: #F7F8F7;
  --c-surface: #FFFFFF;
  --c-surface-soft: #F2F4F2;
  --c-well: #FFFFFF;          /* 图标底=白卡，靠投影浮起 */
  --c-well-deep: #EDEFED;

  --c-ink: #1C2B20;           /* 深绿充当墨色 */
  --c-ink-2: #44514A;
  --c-muted: #8A948E;
  --c-ink-4: #B9C0BB;
  --c-line: rgba(28, 43, 32, 0.08);

  --c-on-ink: #FFFFFF;
  --c-action: #1C2B20;
  --c-action-ink: #FFFFFF;

  --c-gold: #1C2B20;
  --c-gold-light: #C6CDC8;
  --c-gold-soft: #F2F4F2;
  --c-navy: #1C2B20;
  --c-navy-2: #2A3B2E;

  --c-price: #D63A2F;         /* 方案 A 的红更暖 */
  --c-red: #D63A2F;
  --c-red-soft: #FFEDEA;
  --c-green: #2E7D4F;
  --c-green-soft: #E9F5EE;
  --c-orange: #B25000;
  --c-orange-soft: #FFF3E3;
  --c-blue: #0066CC;
  --c-blue-soft: #E8F1FB;

  /* 环境光：绿调，比雾白版更淡（页面已经很白，光晕只做点缀） */
  --c-aura-1: #D6EAD9;
  --c-aura-2: #EAF0E4;
  --c-aura-3: #DFEDE4;

  /* 白卡投影略重，因为底色更接近白，需要更强的浮起感 */
  --e1: 0 2rpx 6rpx rgba(28, 43, 32, 0.05), 0 12rpx 32rpx rgba(28, 43, 32, 0.07);
  --e2: 0 4rpx 8rpx rgba(28, 43, 32, 0.06), 0 24rpx 56rpx rgba(28, 43, 32, 0.1);
  --e3: 0 8rpx 20rpx rgba(28, 43, 32, 0.1), 0 32rpx 72rpx rgba(28, 43, 32, 0.16);
  --e-ink: 0 8rpx 20rpx rgba(28, 43, 32, 0.24);

  /* 主块：深绿实心（不用毛玻璃），这是方案 A 的观感 */
  --c-glass: linear-gradient(150deg, #2A3B2E 0%, #1C2B20 100%);
  --c-glass-flat: #1C2B20;
  --c-glass-edge: rgba(255, 255, 255, 0.08);
  --c-hair: rgba(28, 43, 32, 0.06);

  --c-bar-bg: rgba(255, 255, 255, 0.82);
  --c-sheet-bg: #FFFFFF;
  --c-mask: rgba(28, 43, 32, 0.4);

  --gap: 24rpx;
  --gutter: 28rpx;

  --frost-ink: var(--c-ink);
  --frost-ink-2: var(--c-ink-2);
  --frost-ink-3: var(--c-muted);
  --frost-ink-4: var(--c-ink-4);
  --frost-bg: var(--c-bg);
  --frost-card: var(--c-surface);
  --frost-well: var(--c-well);
  --frost-red: var(--c-red);
  --frost-red-soft: var(--c-red-soft);
  --frost-green: var(--c-green);
  --frost-aura-1: var(--c-aura-1);
  --frost-aura-2: var(--c-aura-2);
  --frost-aura-3: var(--c-aura-3);
  --frost-skin-1: #F8DCC6;
  --frost-skin-2: #E8BE9E;
  --frost-glass: var(--c-glass);
  --frost-glass-flat: var(--c-glass-flat);
  --frost-glass-edge: var(--c-glass-edge);
  --frost-hair: var(--c-hair);
  --frost-e1: var(--e1);
  --frost-e2: var(--e2);
  --frost-e3: var(--e3);
  --frost-ink-shadow: var(--e-ink);

  background: var(--c-bg);
  color: var(--c-ink);
  min-height: 100vh;
}

/* 零售绿的主块是深绿实心，主块内文字必须反白。
 * 用变量表达，组件里就不用为每个主题写一遍覆盖。 */
.theme-retail {
  --c-on-hero: #FFFFFF;
  --c-on-hero-2: rgba(255, 255, 255, 0.66);

  --c-tab-idle: rgba(255, 255, 255, 0.78);
  --c-tab-on: #FFFFFF;

  /* 品牌头变成深绿卡片（方案 A 的顶部大色块） */
  --brand-bg: var(--c-navy);
  --brand-pad: 32rpx 30rpx;
  --brand-radius: var(--radius-xl);
  --brand-mb: var(--gap);
  --brand-shadow: var(--e3);
  --brand-logo-bg: rgba(255, 255, 255, 0.14);
  --brand-logo-ink: #FFFFFF;
  --brand-logo-shadow: none;
  --brand-name: #FFFFFF;
  --brand-slogan: rgba(255, 255, 255, 0.6);
}

/* 零售绿的图标底：白卡 + 投影（方案 A 的标志性做法）。
 * .well 在本主题里需要浮起来而不是凹进去，所以这里单独覆盖内阴影为外投影。 */
.theme-retail {
  /* 图标底浮起而不是凹进：方案 A 的彩色图标衬白卡 */
  --well-shadow: 0 2rpx 6rpx rgba(28, 43, 32, 0.06), 0 8rpx 20rpx rgba(28, 43, 32, 0.08);
}
.theme-retail .well,
.theme-retail .tile .ico,
.theme-retail .quick-icon,
.theme-retail .action-icon,
.theme-retail .biz-item .bi {
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(28, 43, 32, 0.06), 0 8rpx 20rpx rgba(28, 43, 32, 0.08);
}
/* 数据格（.cell .well）在白卡里不适合再浮一层，保持浅底无投影 */
.theme-retail .card .well {
  background: var(--c-surface-soft);
  box-shadow: none;
}

/* ============ 深色主题下的图标提亮 ============
 * 图标是 <image> 引用的 SVG，吃不到 CSS 变量。深色底上原本的饱和彩色
 * 会显得发闷（暗色细节糊在一起），这里用滤镜统一提亮 + 提饱和，
 * 不需要为 55 个图标各生成一套深色变体，包体积也不翻倍。 */
.theme-dark image {
  filter: brightness(1.25) saturate(1.3);
}
/* 底栏图标已经换成了 -light 描边版本（见 custom-tab-bar / staff-tabbar），
 * 不要再叠加滤镜，否则会过曝成一片白。
 * 不用属性选择器（WXSS 对 [src$=] 支持不可靠），走类名。 */
.theme-dark .tabbar .icon,
.theme-dark .icon-light {
  filter: none;
}
