NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=xiamu
DB_USER=erp_runtime
DB_PASSWORD=
FILE_ROOT=../.local/files
OTP_HASH_KEY=
FILE_SIGNING_KEY=
WX_APP_ID=
WX_APP_SECRET=
# Local code target; production must set release and true explicitly.
WX_CODE_ENV=develop
WX_CODE_CHECK_PATH=false
SHARE_HOURS=72
# TODO(confirm): minutes an agent-link order locks the device (5-1440).
AGENT_LOCK_MINUTES=30
# Store confirmation is always required; slots may be a JSON string array.
APPOINTMENT_DAYS=30
APPOINTMENT_SLOTS=
# TODO(confirm): capitalize actual own-device repair costs, or keep separate.
REPAIR_INTERNAL_COST_POLICY=capitalize
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
SMS_APP_ID=
SMS_SIGN=
SMS_TEMPLATE_ID=
SMS_REGION=ap-guangzhou

# 对象存储（腾讯云 COS）。四项都填才启用，缺任意一项回退本地磁盘。
# 存储桶保持「私有读写」，文件访问一律由后端签临时 URL。
COS_BUCKET=
COS_REGION=ap-shanghai
COS_SECRET_ID=
COS_SECRET_KEY=
# internal 凭证的签名 URL 有效期（秒）
COS_SIGN_EXPIRES=300
