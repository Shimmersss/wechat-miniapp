# OS / editor
.DS_Store
*.log

# Secrets: never commit real env files (examples are allowed)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# WeChat DevTools local settings
# 真实 AppID 只写在这里（scripts/appid.sh 设置），project.config.json 固定为占位 touristappid
project.private.config.json
miniprogram_npm/

# Dependencies (rebuildable)
node_modules/

# Persistent local data: MySQL data, account passwords, uploaded files
.local/

# Node logs / runtime (from GitHub template)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid
*.seed
coverage/

# 设计稿截图是构建产物，用 design-demos/shoot.sh 可随时重新生成
design-demos/**/preview.png
design-demos/compare.png

# UI 巡检截图（本地调试产物，体积大且可重新生成）
docs/ui-screenshots/
problem/

# 测试报告里的截图（体积大，报告 markdown 仍然入库）
docs/role-tests/results/**/*.png
docs/test-cases/results/**/*.png

# 含真实凭据的交接文档，只留本地，绝不入库
docs/HANDOFF-*.md

# 开发流程文档（本机自用，不入库）
docs/workflow/
